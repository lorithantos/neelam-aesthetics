<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- Janet.Azure.Storage and Janet.Entra are built from ..\Janet.Shared and packed here
         rather than to nuget.org. The path is relative, so it holds wherever the repos are
         cloned as long as they sit side by side, as ImageSelectorV2's does. A missing feed
         fails the restore with NU1301 rather than quietly. -->
    <add key="local" value="..\.packages" />
  </packageSources>
</configuration>
