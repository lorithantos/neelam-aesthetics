@inherits LayoutComponentBase
@* The operator's pages: managing clients, which belongs to no one client. Kept apart from the
   client-facing layout so a client's people never see admin links, and an admin page always says
   it is one. *@

<header class="site-header">
    <div class="site-header-inner">
        <a class="site-name" href="admin/clients" data-testid="site-name">Campaign safety · Admin</a>
        <nav class="site-nav" aria-label="Admin">
            <NavLink href="admin/clients">Clients</NavLink>
            <a href="/">Client view</a>
        </nav>
    </div>
</header>

<main class="site-main">
    @Body
</main>

<BuildStamp />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
