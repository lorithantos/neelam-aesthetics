@inherits LayoutComponentBase
@* What a client's people see. No admin links: the operator's pages use AdminLayout, under /admin.
   On the demo (Prototype access, the test site only) every page says what is different. *@
@inject SiteMode Site

@if (Site.IsDemo)
{
    <p class="demo-banner" role="note">This is a demo. What you save here is kept on a test system, not your own account, and the AI proofread isn't switched on yet.</p>
}

<header class="site-header">
    <div class="site-header-inner">
        <a class="site-name" href="/">Campaign safety</a>
        <nav class="site-nav" aria-label="Main">
            <NavLink href="how-it-works">How it works</NavLink>
            <NavLink href="campaigns">Campaigns</NavLink>
            <NavLink href="templates">Templates</NavLink>
            <NavLink href="images">Images</NavLink>
        </nav>
    </div>
</header>

<main class="site-main">
    @Body
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
