@inherits LayoutComponentBase
@* What a client's people see. No admin links: the operator's pages use AdminLayout, under /admin.
   On the demo (Prototype access, the test site only) every page says what is different. Drawn in
   the client's own look, where it has one. *@
@inject SiteMode Site
@inject ProofreadSwitch Proofreading

<ClientLookStyle />

@if (Site.IsDemo && Proofreading.IsOn)
{
    <p class="demo-banner" role="note" data-testid="demo-banner">This is a demo. What you save here is kept on a test system, not your own account.</p>
}
else if (Site.IsDemo)
{
    <p class="demo-banner" role="note">This is a demo. What you save here is kept on a test system, not your own account, and the AI proofread isn't switched on yet.</p>
}

<header class="site-header">
    <div class="site-header-inner">
        <a class="site-name" href="/" data-testid="site-name">Campaign safety</a>
        <nav class="site-nav" aria-label="Main">
            <NavLink href="how-it-works">How it works</NavLink>
            <NavLink href="campaigns">Campaigns</NavLink>
            <NavLink href="templates">Templates</NavLink>
            <NavLink href="images">Images</NavLink>
            <NavLink href="known-items">Known items</NavLink>
            <NavLink href="look">Look</NavLink>
        </nav>
    </div>
</header>

<main class="site-main">
    @Body
</main>

<BuildStamp />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
