@* A tiered offer being written: its name and summary, then each tier with its typed benefits.
   Copying a tier is OfferDraft.CopyTier's: the same name and price, which the rules flag until one
   of the two tiers changes each, and every copied benefit marked as not yet checked until it is
   changed or confirmed. Her known items (owner, 2026-10-09) are offered as she writes: a whole
   known tier, a known benefit into a tier, and her known tier names and treatments as suggestions
   while typing. What is picked is ordinary text she typed, never marked as not yet checked; a
   picked tier that repeats another's name or price is flagged by the rules, as a copy is. A tier, a
   benefit line, or the treatment in a benefit's Item field can be saved as a known item exactly as
   written, offered only for what is new to her list (never a near miss, which the checks answer
   with "Did you mean"); what saving says shows beside the button clicked. Removing a tier or a
   benefit is a plain button that asks first. *@
@implements IHandleEvent
<div class="field">
    <label for="offer-name-@Index">Offer name</label>
    <input id="offer-name-@Index" @bind="Offer.Name.Text" @bind:event="oninput" />
    <span class="field-help">Shown as the offer's heading.</span>
</div>
<div class="field">
    <label for="offer-summary-@Index">Summary</label>
    <textarea id="offer-summary-@Index" @bind="Offer.Summary.Text" @bind:event="oninput"></textarea>
    <span class="field-help">One or two sentences on what the offer is.</span>
</div>
<div class="field">
    <label for="offer-note-@Index">Note above the tiers (optional)</label>
    <input id="offer-note-@Index" @bind="Offer.TiersNote.Text" @bind:event="oninput" />
    <span class="field-help">Said once, above every tier, never repeated per tier.</span>
</div>
<div class="field">
    <label for="offer-terms-@Index">Terms link@(Offer.IsRecurring ? "" : " (optional)")</label>
    <input id="offer-terms-@Index" type="url" @bind="Offer.TermsLink.Text" @bind:event="oninput" />
    <span class="field-help">@(Offer.TermsLink.Error ?? "Where cancellation, rollover and refund terms live.")</span>
</div>

<h4>Tiers</h4>
@if (Offer.Tiers.Count == 0)
{
    <p class="muted">No tiers yet.</p>
}
@for (var t = 0; t < Offer.Tiers.Count; t++)
{
    var tierNumber = t + 1;
    var tier = Offer.Tiers[t];
    var id = $"{Index}-t{t}";
    var (_, cannotSaveTier) = tier.ToKnown();
    <section class="card tier" aria-label="Tier @tierNumber">
        <div class="block-card-head">
            <h4>Tier @tierNumber</h4>
            <div class="block-actions">
                <button class="button" disabled="@(!Offer.CanCopy(tier))" title="@(Offer.CanCopy(tier) ? null : "Fill in or remove its empty benefits first")" @onclick="() => Offer.CopyTier(tier)">Copy tier</button>
                @if (SaveKnown is not null && tier.SaveOffered(Known))
                {
                    <button class="button" disabled="@(cannotSaveTier is not null)" title="@cannotSaveTier" @onclick="() => SaveTierAsync(tier)">Save as a known item</button>
                }
                @* Secondary, and asked about first: a whole tier is a lot to lose to a misclick. *@
                <button class="button" aria-label="Remove tier @tierNumber" @onclick="() => _confirmingRemove = tier">Remove tier</button>
            </div>
        </div>
        @if (ReferenceEquals(_confirmingRemove, tier))
        {
            <p role="alert">
                Remove tier @tierNumber@(tier.Name.Text.Trim().Length > 0 ? $", {tier.Name.Text.Trim()}," : "") and everything in it?
                <button class="button danger" @onclick="() => RemoveTier(tier)">Remove it</button>
                <button class="button" @onclick="() => _confirmingRemove = null">Keep it</button>
            </p>
        }
        @if (NoteFor(tier) is { } tierNote)
        {
            <p role="status">@tierNote</p>
        }
        <div class="field">
            <label for="tier-name-@id">Name</label>
            <input id="tier-name-@id" list="@KnownItemLists.Tiers" @bind="tier.Name.Text" @bind:event="oninput" />
            @if (Known.Tiers.Count > 0)
            {
                <span class="field-help">Your known tier names are suggested as you type.</span>
            }
        </div>
        <div class="field">
            <label for="tier-price-@id">Price@(Offer.IsRecurring ? " per month" : ""), in dollars</label>
            <input id="tier-price-@id" inputmode="decimal" @bind="tier.Price.Text" @bind:event="oninput" />
            @if (tier.Price.Error is { } priceError)
            {
                <span class="field-help" role="alert">@priceError</span>
            }
        </div>

        @for (var b = 0; b < tier.Benefits.Count; b++)
        {
            var benefitNumber = b + 1;
            var benefit = tier.Benefits[b];
            var bid = $"{id}-b{b}";
            <div class="benefit @(benefit.IsUnreviewed ? "unreviewed" : null)" aria-label="Tier @tierNumber, benefit @benefitNumber">
                @if (benefit.IsUnreviewed)
                {
                    <p>
                        <strong>Copied from @benefit.CopiedFrom, not yet checked.</strong>
                        Change it below, or confirm it is right for this tier.
                        <button class="button" @onclick="benefit.Confirm">Confirm</button>
                    </p>
                }
                <BenefitFields Benefit="benefit" Id="@bid" Label="@($"Benefit {benefitNumber}")" Changed="ChildChanged" />
                <div class="block-actions">
                    @if (SaveKnown is not null)
                    {
                        @if (benefit.SaveOffered(Known))
                        {
                            <button class="button" disabled="@(benefit.Value is null)" title="@(benefit.Value is null ? "Fill it in first" : null)" @onclick="() => SaveBenefitAsync(benefit)">Save as a known item</button>
                        }
                        @* Only for a treatment new to her list: a near miss gets "Did you mean" from the checks instead. *@
                        @if (benefit.TreatmentToSave(Known) is { } treatment)
                        {
                            <button class="button" @onclick="() => SaveTreatmentAsync(benefit, treatment)">Save "@treatment.Name" as a known treatment</button>
                        }
                    }
                    <button class="button" aria-label="Remove benefit @benefitNumber of tier @tierNumber" @onclick="() => _confirmingRemove = benefit">Remove benefit</button>
                </div>
                @if (ReferenceEquals(_confirmingRemove, benefit))
                {
                    <p role="alert">
                        Remove benefit @benefitNumber of tier @tierNumber?
                        <button class="button danger" @onclick="() => RemoveBenefit(tier, benefit)">Remove it</button>
                        <button class="button" @onclick="() => _confirmingRemove = null">Keep it</button>
                    </p>
                }
                @if (NoteFor(benefit) is { } benefitNote)
                {
                    <p role="status">@benefitNote</p>
                }
            </div>
        }
        <p><button class="button" @onclick="() => tier.AddBenefit()">Add a benefit</button></p>
        @if (Known.Benefits.Count > 0)
        {
            <div class="field">
                <label for="pick-benefit-@id">Pick a benefit</label>
                <input @key="@($"pick-{id}-{_picks}")" id="pick-benefit-@id" list="@KnownItemLists.Benefits" placeholder="Start typing to search your known benefits"
                       value="@PickText(tier)" @oninput="e => PickBenefit(tier, e.Value as string)" />
                <span class="field-help">Choosing one adds it to this tier as a new line, which you can still change.</span>
            </div>
        }
    </section>
}
<p><button class="button" @onclick="() => Offer.AddTier()">Add a tier</button></p>
@if (Known.Tiers.Count > 0)
{
    <div class="field">
        <label for="known-tier-@Index">Add a known tier</label>
        <input @key="@($"known-tier-{_picks}")" id="known-tier-@Index" list="@KnownItemLists.Tiers" placeholder="Start typing to search your known tiers"
               value="@_tierPick" @oninput="e => PickTier(e.Value as string)" />
        <span class="field-help">Choosing one adds the whole tier, its name, price and benefits, which you can still change.</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public OfferEditor Offer { get; set; } = null!;
    [Parameter, EditorRequired] public int Index { get; set; }

    /// <summary>Her known items, to pick from. None: nothing is offered.</summary>
    [Parameter] public KnownItems Known { get; set; } = KnownItems.None;

    /// <summary>Saves a known item and says what happened; null where nothing can be saved.</summary>
    [Parameter] public Func<KnownItem, Task<string>>? SaveKnown { get; set; }

    /// <summary>Told after every change here, so the page around it can follow what is typed.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private readonly Dictionary<TierEditor, string> _benefitPicks = [];
    private string _tierPick = "";
    // What saving a known item said, shown beside the button that was clicked: a tier or a benefit.
    private (object Target, string Text)? _note;
    // The tier or benefit whose Remove is waiting to be confirmed.
    private object? _confirmingRemove;

    private string? NoteFor(object target) => _note is { } note && ReferenceEquals(note.Target, target) ? note.Text : null;

    private void RemoveTier(TierEditor tier)
    {
        Offer.RemoveTier(tier);
        _confirmingRemove = null;
        if (_note is { Target: var target } && (ReferenceEquals(target, tier) || target is BenefitEditor b && tier.Benefits.Contains(b)))
            _note = null;
    }

    private void RemoveBenefit(TierEditor tier, BenefitEditor benefit)
    {
        tier.RemoveBenefit(benefit);
        _confirmingRemove = null;
        if (_note is { Target: var target } && ReferenceEquals(target, benefit)) _note = null;
    }
    // Counts picks; a picker's key carries it, so after a pick the box is made afresh and shows empty
    // even when the browser filled it from the list without a keystroke Blazor saw.
    private int _picks;

    // Blazor re-renders only the component that handled an event, so without this the page's
    // "Still to do" kept saying the offer had no tiers until something on the page itself changed.
    async Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg)
    {
        await callback.InvokeAsync(arg);
        StateHasChanged();
        await Changed.InvokeAsync();
    }

    // A benefit's fields told of a change: handling it here re-renders the offer and tells the page.
    private void ChildChanged()
    {
    }

    private string PickText(TierEditor tier) => _benefitPicks.GetValueOrDefault(tier, "");

    // What she typed or chose; once it names a known benefit, that benefit is added and the box clears.
    private void PickBenefit(TierEditor tier, string? text)
    {
        if (Known.BenefitNamed(text ?? "") is { } known)
        {
            tier.AddKnownBenefit(known.Benefit);
            _benefitPicks.Remove(tier);
            _note = null;
            _picks++;
            return;
        }
        _benefitPicks[tier] = text ?? "";
    }

    private void PickTier(string? text)
    {
        if (Known.TierNamed(text ?? "") is { } known)
        {
            Offer.AddKnownTier(known);
            _tierPick = "";
            _note = null;
            _picks++;
            return;
        }
        _tierPick = text ?? "";
    }

    private async Task SaveTierAsync(TierEditor tier)
    {
        if (tier.ToKnown().Tier is { } known) _note = (tier, await SaveKnown!(known));
    }

    private async Task SaveBenefitAsync(BenefitEditor benefit)
    {
        if (benefit.ToKnown() is { } known) _note = (benefit, await SaveKnown!(known));
    }

    private async Task SaveTreatmentAsync(BenefitEditor benefit, KnownTreatment treatment) =>
        _note = (benefit, await SaveKnown!(treatment));
}
