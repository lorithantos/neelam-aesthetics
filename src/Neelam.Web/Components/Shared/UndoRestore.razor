@* Undo last save and Restore, as the campaign, template and Look pages offer them (owner, 2026-10-09:
   "Undo is forgiving for a day"): Undo asks first, with the question ChangeWords builds, and the undone
   save can be restored until its grace period ends. When undoing the only save would delete the
   document, the page calls it a delete (owner, 2026-11-03): with no DeleteLabel the button is not
   offered, the page having its own Delete (the campaign page); with one, it is offered under that
   name, and asks "Delete it" (the template page, which has no other). Whether she is being asked is
   the page's, so its other actions can close the question. Test ids keep each page's own names.
   Offered as a delete, it takes the campaign Delete's markup and place (owner, 2026-11-03): last,
   in a part of its own with the danger rule above it, a line saying so in words, and the
   destructive style. *@

@if (CanUndo && !UndoDeletes)
{
    @if (Confirming)
    {
        <p>@Question</p>
        <button class="button danger" data-testid="@ConfirmId" @onclick="OnUndo">Undo it</button>
        <button class="button" @onclick="() => ConfirmingChanged.InvokeAsync(false)">Keep it</button>
    }
    else
    {
        <button class="button" data-testid="@UndoId" @onclick="() => ConfirmingChanged.InvokeAsync(true)">Undo last save</button>
    }
}
@if (RestorableUntil is { } until)
{
    <p class="field-help" data-testid="@RestorableId">The last undo can be taken back until @Times.DateAndTime(until).</p>
    <button class="button" data-testid="@RestoreId" @onclick="OnRestore">@RestoreLabel</button>
}
@if (CanUndo && UndoDeletes && DeleteLabel is not null)
{
    <div class="delete-zone" role="group" aria-label="@DeleteLabel" data-testid="@DeleteZoneId">
        @if (Confirming)
        {
            <p>@Question</p>
            <button type="button" class="button danger" data-testid="@ConfirmId" @onclick="OnUndo">Delete it</button>
            <button type="button" class="button" @onclick="() => ConfirmingChanged.InvokeAsync(false)">Keep it</button>
        }
        else
        {
            <p class="delete-warning"><strong>Danger:</strong> @DeleteWarning</p>
            <button type="button" class="button danger" data-testid="@UndoId" @onclick="() => ConfirmingChanged.InvokeAsync(true)">@DeleteLabel</button>
        }
    </div>
}

@code {
    /// <summary>Whether there is a save to undo.</summary>
    [Parameter]
    public bool CanUndo { get; set; }

    /// <summary>Whether the page is asking before an undo.</summary>
    [Parameter]
    public bool Confirming { get; set; }

    [Parameter]
    public EventCallback<bool> ConfirmingChanged { get; set; }

    /// <summary>What is asked before an undo (<see cref="ChangeWords.UndoQuestion"/>).</summary>
    [Parameter, EditorRequired]
    public string Question { get; set; } = "";

    /// <summary>Undoing the last save leaves nothing in use: it deletes the document, which can be restored.</summary>
    [Parameter]
    public bool UndoDeletes { get; set; }

    /// <summary>The button's name when undoing deletes, or null to offer no button then.</summary>
    [Parameter]
    public string? DeleteLabel { get; set; }

    /// <summary>What the delete does, said in words after "Danger:"; required with <see cref="DeleteLabel"/>.</summary>
    [Parameter]
    public string? DeleteWarning { get; set; }

    [Parameter]
    public string DeleteZoneId { get; set; } = "delete-zone";

    [Parameter]
    public EventCallback OnUndo { get; set; }

    /// <summary>Until when the last undo can be taken back, or null when there is nothing to restore.</summary>
    [Parameter]
    public DateTimeOffset? RestorableUntil { get; set; }

    /// <summary>The client's own zone, for that time.</summary>
    [Parameter, EditorRequired]
    public LocalTime Times { get; set; } = default!;

    [Parameter]
    public EventCallback OnRestore { get; set; }

    [Parameter]
    public string RestoreLabel { get; set; } = "Restore undone save";

    [Parameter]
    public string UndoId { get; set; } = "undo-button";

    [Parameter]
    public string ConfirmId { get; set; } = "undo-confirm";

    [Parameter]
    public string? RestorableId { get; set; }

    [Parameter]
    public string? RestoreId { get; set; }

    protected override void OnParametersSet()
    {
        if (this.DeleteLabel is not null && string.IsNullOrWhiteSpace(this.DeleteWarning))
        {
            throw new InvalidOperationException("A delete is offered with a line saying what it does: set DeleteWarning with DeleteLabel.");
        }
    }
}
