@* One photo in a preview, where it sits in the email: a photo on Square is shown from Square's own
   address, so the preview is the image she will pick there. Anything else (an upload, a name the
   library does not hold, sample content with no library) has nothing to show, so it stands in as
   "Photo", marked like a placeholder. Its name and the library's word on it are not in the email:
   PhotoNote says them, outside the block. *@
@if (_entry?.SquareUrl is { } url)
{
    <img class="preview-image" src="@url.AbsoluteUri" alt="@(Image.AltText ?? "")" />
}
else
{
    <span class="placeholder">Photo</span>
}

@code {
    [Parameter, EditorRequired] public ImageRef Image { get; set; } = null!;

    /// <summary>The client's image library, or null where there is none to look in.</summary>
    [Parameter] public IReadOnlyList<LibraryImage>? Library { get; set; }

    private LibraryImage? _entry;

    protected override void OnParametersSet() =>
        _entry = Library is null ? null : ImageLibrary.Find(Library, Image.Name);
}
