@* The parts every template should have: the standard baseline, or the client's own. The baseline
   is the client's data like its templates, so the access check decides whose. *@
@inject ClientWorkspace Workspace
@inject ClientStores Stores

@if (_client is not null && _inForce is not null)
{
    var parts = _inForce.Baseline.Parts;
    <section class="card" aria-labelledby="baseline-heading">
        <h2 id="baseline-heading">Every template should have</h2>
        <p class="muted">@(_inForce.IsOwn ? "Your own baseline." : "The standard baseline.")
            A template without one of these still saves; its editor says what it lacks. A new template
            starts with them, top to bottom in this order.</p>
        @if (parts.Count == 0)
        {
            <p>Nothing: these warnings are off.</p>
        }
        else
        {
            <ol>
                @foreach (var part in parts)
                {
                    <li>@BlockGuide.For(part).Name</li>
                }
            </ol>
        }

        <details>
            <summary>Change it</summary>
            @foreach (var guide in BlockGuide.All.Where(g => g.Type != BlockType.Spacer))
            {
                var type = guide.Type;
                <label class="check">
                    <input type="checkbox" checked="@_chosen.Parts.Contains(type)" @onchange="e => Choose(type, e.Value is true)" />
                    @guide.Name
                </label>
            }
            @if (_chosen.Parts.Count > 0)
            {
                <p class="field-help">Top to bottom, as a new template starts:</p>
                @* Laid out as the ladders' words are, Up and Down beside each. *@
                <ol class="ladder-words">
                    @for (var i = 0; i < _chosen.Parts.Count; i++)
                    {
                        var index = i;
                        var name = BlockGuide.For(_chosen.Parts[index]).Name;
                        <li>
                            <span>@name</span>
                            <span class="block-actions">
                                <button class="button" aria-label="Move @name up" disabled="@(index == 0)"
                                        @onclick="() => Order(index, -1)">Up</button>
                                <button class="button" aria-label="Move @name down" disabled="@(index == _chosen.Parts.Count - 1)"
                                        @onclick="() => Order(index, 1)">Down</button>
                            </span>
                        </li>
                    }
                </ol>
            }
            <p>
                <button class="button primary" @onclick="SaveOwnAsync">Save as your own</button>
                <button class="button" @onclick="SaveEmptyAsync">Save it empty: no warnings</button>
                @if (_inForce.IsOwn)
                {
                    <button class="button" @onclick="UseStandardAsync">Use the standard baseline</button>
                }
            </p>
        </details>
        @if (_message is not null)
        {
            <p role="status">@_message</p>
        }
    </section>
}

@code {
    private ClientName? _client;
    private BaselineInForce? _inForce;
    // Her changes, parts and order, not saved until "Save as your own".
    private TemplateBaseline _chosen = TemplateBaseline.None;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        (_client, _) = await Workspace.ClientDataAsync();
        if (_client is not null) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _inForce = await Stores.BaselineInForceAsync(_client!);
        _chosen = _inForce.Baseline;
    }

    // A part she ticks goes last; she moves it from there.
    private void Choose(BlockType type, bool chosen) =>
        _chosen = chosen ? _chosen.With(type) : _chosen.Without(type);

    private void Order(int index, int by) => _chosen = _chosen.Move(index, by);

    private async Task SaveOwnAsync()
    {
        await Stores.SaveBaselineAsync(_client!, _chosen, await Workspace.ActorAsync());
        await LoadAsync();
        _message = "Saved as your own baseline.";
    }

    private async Task SaveEmptyAsync()
    {
        await Stores.SaveBaselineAsync(_client!, TemplateBaseline.None, await Workspace.ActorAsync());
        await LoadAsync();
        _message = "Saved empty: templates get no baseline warnings.";
    }

    private async Task UseStandardAsync()
    {
        await Stores.UseStandardBaselineAsync(_client!, await Workspace.ActorAsync());
        await LoadAsync();
        _message = "Your own baseline is deleted; the standard one applies.";
    }
}
