@* The parts every template should have: the standard baseline, or the client's own. The baseline
   is the client's data like its templates, so the access check decides whose. Another tab or person
   may change it while this is open (2026-10-11, phase 2): PageWatch tells the section, and each save
   here is made only while her newest version is still the one shown, read again at the click; when it
   is not, she chooses Keep mine or Load the latest, as on the campaign page. "Use the standard
   baseline" saves a version saying so and deletes nothing. *@
@inherits WatchedComponent<DocumentVersion>
@inject ClientWorkspace Workspace
@inject ClientStores Stores
@inject BlockCatalog Blocks

@if (_client is not null && _inForce is not null)
{
    var parts = _inForce.Baseline.Parts;
    <section class="card" aria-labelledby="baseline-heading">
        <h2 id="baseline-heading">Every template should have</h2>
        <p class="muted" data-testid="baseline-status">@(_inForce.IsOwn ? "Your own baseline." : "The standard baseline.")
            A template without one of these still saves; its editor says what it lacks. A new template
            starts with them, top to bottom in this order.</p>

        @* The owner's "modified" (2026-10-11), as on the campaign page: what she chose here stays until
           she loads the latest; after a save refused, Keep mine saves hers over the other version. *@
        <ModifiedNotice Words="ChangeWords.Baseline" Change="StorageChange" Refused="@_refused?.Message" KeepMine="KeepMineWhen.AfterRefusal"
                        OnKeepMine="KeepMineAsync" OnLoadLatest="LoadLatestAsync" Prefix="baseline-" TestId="baseline-modified" Inline="true"
                        Help="@(_refused is not null
                            ? "Keep mine saves yours as the newest; the other version stays stored. Load the latest shows the other version and replaces what you chose here."
                            : "Load the latest replaces what you chose here and have not saved.")" />

        @if (parts.Count == 0)
        {
            <p>Nothing: these warnings are off.</p>
        }
        else
        {
            <ol data-testid="baseline-parts">
                @foreach (var part in parts)
                {
                    <li>@Blocks.For(part).Label</li>
                }
            </ol>
        }

        <details>
            <summary>Change it</summary>
            @foreach (var guide in Blocks.All.Where(g => g.Type != BlockType.Spacer))
            {
                var type = guide.Type;
                <label class="check">
                    <input type="checkbox" checked="@_chosen.Parts.Contains(type)" @onchange="e => Choose(type, e.Value is true)" />
                    @guide.Label
                </label>
            }
            @if (_chosen.Parts.Count > 0)
            {
                <p class="field-help">Top to bottom, as a new template starts:</p>
                @* Laid out as the ladders' words are, Up and Down beside each. *@
                <ol class="ladder-words">
                    @for (var i = 0; i < _chosen.Parts.Count; i++)
                    {
                        var index = i;
                        var name = Blocks.For(_chosen.Parts[index]).Label;
                        <li>
                            <span>@name</span>
                            <span class="block-actions">
                                <button class="button" aria-label="Move @name up" disabled="@(index == 0)"
                                        @onclick="() => Order(index, -1)">Up</button>
                                <button class="button" aria-label="Move @name down" disabled="@(index == _chosen.Parts.Count - 1)"
                                        @onclick="() => Order(index, 1)">Down</button>
                            </span>
                        </li>
                    }
                </ol>
            }
            <p>
                <button class="button primary" data-testid="baseline-save-own" @onclick="SaveOwnAsync">Save as your own</button>
                <button class="button" data-testid="baseline-save-empty" @onclick="SaveEmptyAsync">Save it empty: no warnings</button>
                @if (_inForce.IsOwn)
                {
                    <button class="button" data-testid="baseline-use-standard" @onclick="UseStandardAsync">Use the standard baseline</button>
                }
            </p>
        </details>
        @if (_message is not null)
        {
            <p role="status" data-testid="baseline-message">@_message</p>
        }
    </section>
}

@code {
    private ClientName? _client;
    private BaselineInForce? _inForce;
    // Her changes, parts and order, not saved until "Save as your own".
    private TemplateBaseline _chosen = TemplateBaseline.None;
    private string? _message;

    // Her baseline as this section shows it, which the section's look at storage watches.
    private HeldDocument? _held;

    // A save refused because her baseline changed since it was shown: what was said, and the same save
    // again over the other version, for Keep mine.
    private (string Message, Func<Task<string>> KeepMine)? _refused;

    protected override async Task OnInitializedAsync()
    {
        (_client, _) = await Workspace.ClientDataAsync();
        if (_client is null) return;
        await LoadAsync();
        Watch(_held);
    }

    private async Task LoadAsync()
    {
        _inForce = await Stores.BaselineInForceAsync(_client!);
        _chosen = _inForce.Baseline;
        _held = Stores.HoldBaseline(_client!, _inForce.Version);
        _refused = null;
    }

    // A part she ticks goes last; she moves it from there.
    private void Choose(BlockType type, bool chosen) =>
        _chosen = chosen ? _chosen.With(type) : _chosen.Without(type);

    private void Order(int index, int by) => _chosen = _chosen.Move(index, by);

    // One save: refused when her baseline changed since it was shown, and then offered again as Keep
    // mine. Done, the section reads her baseline again, and watches what it holds now; what storage says
    // meanwhile is not news.
    private Task SavingAsync(Func<bool, Task<string>> save) => ActingAsync(async () =>
    {
        try
        {
            _message = await save(false);
            await LoadAsync();
        }
        catch (CampaignChangedException ex)
        {
            _message = null;
            _refused = (ex.Message, () => save(true));
        }
        finally
        {
            Watch(_held);
        }
    });

    private Task SaveOwnAsync()
    {
        var chosen = _chosen;
        return SavingAsync(async keepMine =>
        {
            await Stores.SaveBaselineAsync(_held!, chosen, await Workspace.ActorAsync(), keepMine);
            return "Saved as your own baseline.";
        });
    }

    private Task SaveEmptyAsync() => SavingAsync(async keepMine =>
    {
        await Stores.SaveBaselineAsync(_held!, TemplateBaseline.None, await Workspace.ActorAsync(), keepMine);
        return "Saved empty: templates get no baseline warnings.";
    });

    private Task UseStandardAsync() => SavingAsync(async keepMine =>
    {
        await Stores.UseStandardBaselineAsync(_held!, await Workspace.ActorAsync(), keepMine);
        return "The standard baseline applies again.";
    });

    // "Keep mine": the refused save, made over the other version, which stays stored.
    private async Task KeepMineAsync()
    {
        if (_refused is not { } refused) return;
        await SavingAsync(_ => refused.KeepMine());
    }

    // "Load the latest": her baseline as storage has it now, replacing what she chose here. Only ever on her click.
    private Task LoadLatestAsync() => ActingAsync(async () =>
    {
        try
        {
            await LoadAsync();
            _message = "The latest version is open.";
        }
        finally
        {
            Watch(_held);
        }
    });
}
