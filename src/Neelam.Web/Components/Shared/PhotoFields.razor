@* A photo from the client's image library, by name, and its alt text. *@
@implements IHandleEvent
<div class="field">
    <label for="photo-@Index">Photo@(Optional ? " (optional)" : "")</label>
    <input id="photo-@Index" list="library-photos-@Index" @bind="Block.PhotoName" @bind:event="oninput" />
    <datalist id="library-photos-@Index">
        @foreach (var photo in Photos)
        {
            <option value="@photo.Name"></option>
        }
    </datalist>
    @if (!string.IsNullOrWhiteSpace(Block.PhotoName) && ImageLibrary.Find(Photos, Block.PhotoName) is null)
    {
        @* The preview says the same, in the same words: one lookup, one message. *@
        <span class="field-help">@ImageLibrary.NotInLibrary</span>
    }
    else
    {
        <span class="field-help">The photo's name in the <a href="images">image library</a>.</span>
    }
</div>
<div class="field">
    <label for="alt-@Index">Text if images do not load</label>
    <input id="alt-@Index" @bind="Block.PhotoAltText" @bind:event="oninput" />
</div>

@code {
    [Parameter, EditorRequired] public IPhotoChoice Block { get; set; } = null!;
    [Parameter, EditorRequired] public int Index { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<LibraryImage> Photos { get; set; } = [];
    [Parameter] public bool Optional { get; set; }

    /// <summary>Told after every change here, so the page around it can follow what is typed.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    // Blazor re-renders only the component that handled an event; the page's checks and preview
    // need to hear of it too.
    async Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg)
    {
        await callback.InvokeAsync(arg);
        StateHasChanged();
        await Changed.InvokeAsync();
    }
}
