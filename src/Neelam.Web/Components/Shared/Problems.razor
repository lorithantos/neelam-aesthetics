@* A list of what stops an action, or nothing at all when there is none. *@
@if (Messages.Count > 0)
{
    <ul class="errors" role="alert">
        @foreach (var message in Messages)
        {
            <li>@message</li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Messages { get; set; } = [];
}
