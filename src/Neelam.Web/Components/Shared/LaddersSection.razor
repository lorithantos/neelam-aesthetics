@* Tier-name ladders (owner, 2026-10-09): the standard ones, or the client's own, which replace them.
   They are the client's data like its templates, so the access check decides whose. Her changes are
   a working copy until she saves them as her own. Another tab or person may change them while this is
   open (2026-10-11, phase 2): as for the baseline, PageWatch tells the section, each save is made only
   while her newest version is still the one shown, and "Use the standard ladders" deletes nothing. *@
@inject ClientWorkspace Workspace
@inject ClientStores Stores
@inject CampaignSignals Signals
@inject TimeProvider Clock
@inject Microsoft.Extensions.Options.IOptions<CampaignWatchOptions> WatchOptions
@inject ILogger<LaddersSection> Log
@implements IDisposable

@if (_client is not null && _inForce is not null && _working is not null)
{
    var change = _watch?.Change ?? CampaignChange.None;
    <h2 id="ladders-heading">Tier name ladders</h2>
    <section class="card" aria-labelledby="ladders-heading">
        <p class="muted" data-testid="ladders-status">@(_inForce.IsOwn ? "Your own ladders." : "The standard ladders.")
            Tier names that use these words tell readers which tier is which. The checks point out two tiers
            on the same word, and, on an ordered ladder, a higher word that costs less. Neither stops an email.</p>

        @if (change != CampaignChange.None || _refused is not null)
        {
            @* As for the baseline: what she changed here stays until she loads the latest; after a save
               refused, Keep mine saves hers over the other version. *@
            <div class="card" role="alert" data-testid="ladders-modified">
                @if (change != CampaignChange.None)
                {
                    <p data-testid="ladders-modified-what">@HeldDocument.ChangedNotice(WatchSubject.Ladders, change)</p>
                }
                @if (_refused is not null)
                {
                    <p data-testid="ladders-refused">@_refused.Value.Message</p>
                    <button class="button" data-testid="ladders-keep-mine" @onclick="KeepMineAsync">Keep mine</button>
                }
                <button class="button primary" data-testid="ladders-load-latest" @onclick="LoadLatestAsync">Load the latest</button>
                <p class="field-help">@(_refused is not null
                    ? "Keep mine saves yours as the newest; the other version stays stored. Load the latest shows the other version and replaces what you changed here."
                    : "Load the latest replaces what you changed here and have not saved.")</p>
            </div>
        }
        @if (_working.Ladders.Count == 0)
        {
            <p>No ladders: tier names are not read against any.</p>
        }
        @for (var l = 0; l < _working.Ladders.Count; l++)
        {
            var index = l;
            var ladder = _working.Ladders[index];
            <section class="card" aria-label="@ladder.Name">
                <h3>@ladder.Name</h3>
                <p class="muted">@(ladder.Ordered ? "Ordered, lowest first: a tier on a higher word should cost more." : "Equal weight: the words only tell tiers apart.")</p>
                <ol class="ladder-words">
                    @for (var w = 0; w < ladder.Words.Count; w++)
                    {
                        var word = w;
                        <li>
                            <span>@ladder.Words[word]</span>
                            <span class="block-actions">
                                <button class="button" aria-label="Move @ladder.Words[word] lower" disabled="@(word == 0)"
                                        @onclick="() => Change(index, ladder.Move(word, -1))">Lower</button>
                                <button class="button" aria-label="Move @ladder.Words[word] higher" disabled="@(word == ladder.Words.Count - 1)"
                                        @onclick="() => Change(index, ladder.Move(word, 1))">Higher</button>
                            </span>
                        </li>
                    }
                </ol>
                <p class="block-actions">
                    <button class="button" @onclick="() => Change(index, ladder.WithOrdered(!ladder.Ordered))">
                        @(ladder.Ordered ? "Make the words equal weight" : "Order the words, lowest first")
                    </button>
                    <button class="button danger" aria-label="Remove the @ladder.Name ladder" @onclick="() => Remove(index)">Remove ladder</button>
                </p>
            </section>
        }

        <details>
            <summary>Add a ladder</summary>
            <div class="field">
                <label for="ladder-name">Name</label>
                <input id="ladder-name" @bind="_newName" @bind:event="oninput" />
            </div>
            <div class="field">
                <label for="ladder-words">Words, lowest first</label>
                <input id="ladder-words" @bind="_newWords" @bind:event="oninput" />
                <span class="field-help">Separated by commas, such as "Glow, Radiance, Luminous".</span>
            </div>
            <label class="check">
                <input type="checkbox" checked="@_newOrdered" @onchange="e => _newOrdered = e.Value is true" />
                Ordered: a tier on a later word should cost more
            </label>
            <p><button class="button" @onclick="Add">Add ladder</button></p>
        </details>

        <p>
            <button class="button primary" data-testid="ladders-save-own" @onclick="SaveOwnAsync">Save as your own</button>
            @if (_inForce.IsOwn)
            {
                <button class="button" data-testid="ladders-use-standard" @onclick="UseStandardAsync">Use the standard ladders</button>
            }
        </p>
        @if (_message is not null)
        {
            <p role="status" data-testid="ladders-message">@_message</p>
        }
    </section>
}

@code {
    private ClientName? _client;
    private LaddersInForce? _inForce;
    // Her changes, not saved until "Save as your own".
    private TierLadders? _working;
    private string _newName = "";
    private string _newWords = "";
    private bool _newOrdered;
    private string? _message;

    // Her ladders as this section shows them, and the section's look at storage for changes to them.
    private HeldDocument? _held;
    private PageWatch<DocumentVersion>? _watch;

    // A save refused because her ladders changed since they were shown: what was said, and the same save
    // again over the other version, for Keep mine.
    private (string Message, Func<Task<string>> KeepMine)? _refused;

    protected override async Task OnInitializedAsync()
    {
        (_client, _) = await Workspace.ClientDataAsync();
        if (_client is null) return;
        await LoadAsync();
        _watch = new PageWatch<DocumentVersion>(Signals, Clock, WatchOptions.Value.Interval, OnCircuitAsync, Log);
        _watch.Watch(_held);
    }

    private async Task LoadAsync()
    {
        _inForce = await Stores.LaddersInForceAsync(_client!);
        _working = _inForce.Ladders;
        _held = Stores.HoldLadders(_client!, _inForce.Version);
        _refused = null;
    }

    // The watch's news, on this section's circuit, and the section drawn again with it.
    private Task OnCircuitAsync(Func<Task> work) => InvokeAsync(async () =>
    {
        await work();
        StateHasChanged();
    });

    protected override void OnAfterRender(bool firstRender) => _watch?.Start();

    // One save: refused when her ladders changed since they were shown, and then offered again as Keep
    // mine. Done, the section reads her ladders again; what storage says meanwhile is not news.
    private async Task SavingAsync(Func<bool, Task<string>> save)
    {
        _watch?.Begin();
        try
        {
            _message = await save(false);
            await LoadAsync();
        }
        catch (CampaignChangedException ex)
        {
            _message = null;
            _refused = (ex.Message, () => save(true));
        }
        finally
        {
            if (_watch is not null)
            {
                _watch.Watch(_held);
                await _watch.EndAsync();
            }
        }
    }

    // "Keep mine": the refused save, made over the other version, which stays stored.
    private async Task KeepMineAsync()
    {
        if (_refused is not { } refused) return;
        await SavingAsync(_ => refused.KeepMine());
    }

    // "Load the latest": her ladders as storage has them now, replacing what she changed here. Only ever on her click.
    private async Task LoadLatestAsync()
    {
        _watch?.Begin();
        try
        {
            await LoadAsync();
            _message = "The latest version is open.";
        }
        finally
        {
            if (_watch is not null)
            {
                _watch.Watch(_held);
                await _watch.EndAsync();
            }
        }
    }

    // With the circuit: the timer stops and the section stops listening.
    public void Dispose() => _watch?.Dispose();

    private void Change(int index, TierLadder ladder)
    {
        _working = _working!.Replace(index, ladder);
        _message = "Not saved yet: save them as your own to use them.";
    }

    private void Remove(int index)
    {
        _working = _working!.Without(index);
        _message = "Not saved yet: save them as your own to use them.";
    }

    private void Add()
    {
        var (ladder, problem) = TierLadder.Parse(_newName, _newWords, _newOrdered);
        if (ladder is null)
        {
            _message = problem;
            return;
        }
        if (_working!.Ladders.Any(l => string.Equals(l.Name, ladder.Name, StringComparison.OrdinalIgnoreCase)))
        {
            _message = $"There is already a ladder named '{ladder.Name}'.";
            return;
        }
        _working = _working.With(ladder);
        (_newName, _newWords, _newOrdered) = ("", "", false);
        _message = "Not saved yet: save them as your own to use them.";
    }

    private Task SaveOwnAsync()
    {
        var working = _working!;
        return SavingAsync(async keepMine =>
        {
            await Stores.SaveLaddersAsync(_held!, working, await Workspace.ActorAsync(), keepMine);
            return "Saved as your own ladders.";
        });
    }

    private Task UseStandardAsync() => SavingAsync(async keepMine =>
    {
        await Stores.UseStandardLaddersAsync(_held!, await Workspace.ActorAsync(), keepMine);
        return "The standard ladders apply again.";
    });
}
