@page "/templates/new"
@page "/templates/{Id:guid}"
@* Changing a client's layouts is its own feature, apart from writing campaigns; the access
   check decides whose templates, on top of the policy. Another tab or person may change the template
   while this page is open (2026-10-11, phase 2): PageWatch tells the page, at once on this instance and
   within CampaignWatch:Interval from anywhere, and the page says so with "Load the latest", keeping her
   unsaved edits until she chooses; Undo takes back only the version on the page while it is still the
   newest. Save itself is not checked yet (phase 3). *@
@attribute [Authorize(Policy = Features.Templates)]
@rendermode InteractiveServer
@inherits WatchedComponent<SaveRef>
@inject ClientWorkspace Workspace
@inject ClientStores Stores
@inject NavigationManager Navigation
@inject BlockCatalog Blocks
@inject IAuthorizationService Authorization
@inject ILogger<TemplateEdit> Log

<PageTitle>@Title</PageTitle>

@if (_denied is not null)
{
    <h1>Templates</h1>
    <p>You cannot change templates here: @_denied.</p>
}
else if (_missing)
{
    <h1>Template not found</h1>
    <p>There is no saved template here. It may have been deleted. <a href="templates">Back to templates</a></p>
}
else if (_undone is not null)
{
    <h1>@_undone.Title</h1>
    <p>Its last save was undone, so it is gone from your templates. You can restore it until
        @Times.DateAndTime(_store!.RestorableUntil(_undone)!.Value); after that it is deleted for good.</p>
    <button class="button primary" @onclick="RestoreUndoneAsync">Restore</button>
    <a class="button" href="templates">Back to templates</a>
}
else if (_session is not null)
{
    var editor = _session.Editor;
    var errors = editor.Errors();
    var advice = editor.Advice(_policy, _photos.Select(p => p.Name).ToList());
    var missing = editor.Missing(_baseline);

    <h1>@Title</h1>
    <KnownItemLists Known="_known" />
    <p><a href="templates">Back to templates</a></p>
    @* The whole email's preview is at the foot of the side column, after every block on a phone
       (owner, 2026-10-31: "maybe make it easier to find even on a computer"): a link to it here, on
       this page's own address so it only moves down, and on a wide screen it stays in view. *@
    <p><a href="@($"templates/{(_session.Id is { } id ? id.ToString() : "new")}#template-preview")" data-testid="preview-link">See the whole email's preview</a></p>
    @* Straight to a campaign from this template (owner, 2026-11-03). A campaign starts from the newest
       save, so while the page holds changes not saved the link is not offered: it would leave them
       behind without a word. A template never saved has nothing to start from. *@
    @if (_canStartCampaigns && _session.Latest is not null && _session.Id is { } savedId)
    {
        @if (_session.HasUnsavedChanges)
        {
            <p class="field-help" data-testid="start-campaign-unsaved">Save your changes to start a campaign from this template.</p>
        }
        else
        {
            <p><a href="campaigns/new/@savedId" data-testid="start-campaign">Start a campaign from this template</a></p>
        }
    }

    @* The owner's "modified" (2026-10-11), as on the campaign page, without Keep mine: what she typed
       stays until she loads the latest, and the notice says what loading does to it. *@
    <ModifiedNotice Words="ChangeWords.Template" Change="StorageChange" OnLoadLatest="LoadLatestAsync"
                    Unsaved="@(_session.HasUnsavedChanges ? ModifiedNotice.ChangesNotSaved : null)" />

    <div class="workspace">
        <div class="workspace-main">
            <div class="field">
                <label for="template-name">Template name</label>
                <input id="template-name" data-testid="template-name" @bind="editor.Name" @bind:event="oninput" />
                <span class="field-help">What people choose when they start a campaign, such as "Membership announcement".</span>
            </div>

            @* Arranging lives here alone, every block in view at once (owner, 2026-11-03); the cards
               below follow its order and have no Up or Down of their own. *@
            @if (editor.Blocks.Count > 1)
            {
                <ArrangeBlocks Editor="editor" Moved="StateHasChanged" />
            }

            <h2>Blocks, top to bottom</h2>
            @if (editor.FromBaseline && _session.Id is null)
            {
                <p class="field-help">Started with the parts every template should have. <a href="templates#baseline-heading">Change that list on the Templates page.</a></p>
            }
            @if (editor.Blocks.Count == 0)
            {
                <p class="muted">No blocks yet. Add them below in the order the email shows them.</p>
            }
            @for (var i = 0; i < editor.Blocks.Count; i++)
            {
                var index = i;
                var block = editor.Blocks[index];
                var guide = editor.Catalog.For(block.Type);
                @* Keyed by its block, so what the browser holds in a card (an open "What the checks look
                   for") moves with the block. *@
                <section @key="block" class="card block-card" aria-label="@block.Label" data-testid="block-card-@index">
                    <div class="block-card-head">
                        <h3>@guide.Label</h3>
                        <div class="block-actions">
                            <button class="button danger" aria-label="Remove @block.Label" @onclick="() => editor.Remove(block)">Remove</button>
                        </div>
                    </div>
                    <p class="field-help">@guide.Description</p>

                    <div class="field">
                        <label for="label-@index">Label</label>
                        <input id="label-@index" @bind="block.Label" @bind:event="oninput" />
                        <span class="field-help">How the checks name this block when they find something.</span>
                    </div>

                    @* One choice, not two checkboxes (owner, 2026-11-03: "These are check boxes and that's not
                       how check boxes work either. But the real problem is that there is no "default
                       text""): the same every time, something to start with that each campaign can change,
                       or nothing. Whether every campaign must have it is a separate question, asked of a
                       fixed block too (owner, 2026-11-03: "Any fixed block can be removed": fixed is what it
                       says, not that it must be there). A spacer has nothing to choose. *@
                    @if (block.CanStartFilled)
                    {
                        <fieldset class="choice" data-testid="content-choice-@index">
                            <legend>What each campaign gets</legend>
                            @if (block.CanBeFixed)
                            {
                                <label class="check"><input type="radio" name="content-@index" data-testid="content-fixed-@index" checked="@(block.Content == BlockContent.Fixed)" @onchange="() => block.Content = BlockContent.Fixed" /> This, the same in every campaign</label>
                            }
                            <label class="check"><input type="radio" name="content-@index" data-testid="content-default-@index" checked="@(block.Content == BlockContent.Default)" @onchange="() => block.Content = BlockContent.Default" /> This to start with; each campaign can change it</label>
                            <label class="check"><input type="radio" name="content-@index" data-testid="content-empty-@index" checked="@(block.Content == BlockContent.Empty)" @onchange="() => block.Content = BlockContent.Empty" /> Nothing; each campaign fills it in</label>
                        </fieldset>
                        <label class="check"><input type="checkbox" data-testid="required-@index" @bind="block.Required" /> Every campaign must have it</label>
                        @if (block.IsFixed && !block.Required)
                        {
                            @* The campaign page cannot leave a block out yet (decision 8a), so say what happens now. *@
                            <p class="field-help" data-testid="fixed-optional-note-@index">Campaigns can't leave a block out yet, so for now this one still goes out in every campaign.</p>
                        }
                    }

                    @if (block.Type == BlockType.Offer)
                    {
                        <label class="check"><input type="checkbox" @bind="block.Recurring" /> Customers are charged every month</label>
                        <div class="field">
                            <label for="marker-@index">Benefit marker</label>
                            <input id="marker-@index" @bind="block.Marker" @bind:event="oninput" />
                            <span class="field-help">What starts each benefit line, such as 🤍. Left blank, a bullet (•).</span>
                        </div>
                    }

                    @if (block.Content != BlockContent.Empty)
                    {
                        @switch (block.Type)
                        {
                            // An offer or a promotion to start with is written with the campaign page's own
                            // fields, her known items offered as there; nothing is saved to them from here.
                            case BlockType.Offer when block.DefaultOffer is { } offer:
                                <OfferFields Offer="offer" Index="index" Known="_known" Changed="StateHasChanged" />
                                break;
                            case BlockType.Promotion when block.DefaultPromotion is { } promotion:
                                <PromotionFields Promotion="promotion" Index="index" Known="_known" Changed="StateHasChanged" />
                                break;
                            case BlockType.Heading:
                            case BlockType.Greeting:
                                <div class="field">
                                    <label for="text-@index">@(block.Type == BlockType.Heading ? "Heading" : "Greeting")</label>
                                    <input id="text-@index" data-testid="text-@index" @bind="block.Text" @bind:event="oninput" />
                                </div>
                                break;
                            case BlockType.FinePrint:
                                <div class="field">
                                    <label for="text-@index">Fine print</label>
                                    <textarea id="text-@index" @bind="block.Text" @bind:event="oninput"></textarea>
                                </div>
                                break;
                            case BlockType.Paragraphs:
                                <div class="field">
                                    <label for="paragraphs-@index">Paragraphs</label>
                                    <textarea id="paragraphs-@index" @bind="block.Paragraphs" @bind:event="oninput"></textarea>
                                    <span class="field-help">Leave a blank line between paragraphs.</span>
                                </div>
                                break;
                            case BlockType.Header:
                                <div class="field">
                                    <label for="text-@index">Business name</label>
                                    <input id="text-@index" @bind="block.Text" @bind:event="oninput" />
                                </div>
                                <PhotoFields Block="block" Index="index" Photos="_photos" Optional="true" Changed="StateHasChanged" />
                                break;
                            case BlockType.Image:
                                <PhotoFields Block="block" Index="index" Photos="_photos" Optional="false" Changed="StateHasChanged" />
                                break;
                            case BlockType.Button:
                                <div class="field">
                                    <label for="button-label-@index">Button text</label>
                                    <input id="button-label-@index" @bind="block.ButtonLabel" @bind:event="oninput" />
                                </div>
                                <div class="field">
                                    <label for="button-url-@index">Link</label>
                                    <input id="button-url-@index" type="url" @bind="block.ButtonUrl" @bind:event="oninput" />
                                    <span class="field-help">The full address, starting https://.</span>
                                </div>
                                break;
                            case BlockType.SignOff:
                                <div class="field">
                                    <label for="valediction-@index">Valediction</label>
                                    <input id="valediction-@index" @bind="block.Valediction" @bind:event="oninput" />
                                    <span class="field-help">Such as "With love,".</span>
                                </div>
                                <div class="field">
                                    <label for="from-@index">From</label>
                                    <input id="from-@index" @bind="block.From" @bind:event="oninput" />
                                </div>
                                <div class="field">
                                    <label for="tagline-@index">Tagline (optional)</label>
                                    <input id="tagline-@index" @bind="block.Tagline" @bind:event="oninput" />
                                </div>
                                break;
                        }
                        @* How it goes out, beside what is typed, as the campaign page shows a fixed block:
                           on a phone the whole email's preview is far below, after every block. *@
                        @if (block.FixedPreview is { Count: > 0 } fixedPreview)
                        {
                            <section data-testid="fixed-preview-@index">
                                <p class="field-help">It goes out like this:</p>
                                <EmailPreview Blocks="fixedPreview" Library="_photos" />
                            </section>
                        }
                        @if (block.DefaultPreview is { Count: > 0 } defaultPreview)
                        {
                            <section data-testid="default-preview-@index">
                                <p class="field-help">Each campaign starts with this, and can change it:</p>
                                <EmailPreview Blocks="defaultPreview" Library="_photos" />
                            </section>
                        }
                    }

                    @if (guide.Checks.Count > 0)
                    {
                        <details data-testid="block-checks-@index">
                            <summary>What the checks look for in this block</summary>
                            <ul>
                                @foreach (var check in guide.Checks)
                                {
                                    <li>@check</li>
                                }
                            </ul>
                        </details>
                    }
                </section>
            }

            <h2>Add a block</h2>
            <div class="add-blocks" data-testid="add-blocks">
                @foreach (var guide in editor.Catalog.All)
                {
                    <button class="button add-block" @onclick="() => editor.Add(guide.Type)">
                        <strong>@guide.Label</strong>
                        <span>@guide.Description</span>
                    </button>
                }
            </div>
        </div>

        <aside class="workspace-side">
            <section class="card" data-testid="save-card">
                <h2>Save</h2>
                <Problems Messages="@errors.Select(e => $"{e.Where}: {e.Message}").ToList()" />
                @if (missing.Count > 0)
                {
                    @* The baseline warns and never blocks: a short note may rightly lack a part. *@
                    <ul class="advice" aria-label="Parts this template lacks">
                        @foreach (var gap in missing)
                        {
                            <li>@gap.Message</li>
                        }
                    </ul>
                    <p class="field-help">It can still be saved. The parts every template should have are listed under <a href="templates">Templates</a>.</p>
                }
                <button class="button primary" data-testid="save-button" disabled="@(errors.Count > 0)" @onclick="SaveAsync">Save template</button>
                @if (_message is not null)
                {
                    <p role="status" data-testid="page-message">@_message</p>
                }
                @if (_session.Latest is { } latest)
                {
                    <p class="muted" data-testid="last-saved">Last saved @Times.DateAndTime(latest.SavedAt).</p>
                }
                @* Undoing the only save deletes the template, restorable for the grace period, so it is
                   called that (owner, 2026-11-03), as on the campaign page; the template has no other Delete.
                   Offered so, it is set apart last in this card in the danger style, as the campaign's
                   Delete is (owner, 2026-11-03). *@
                <UndoRestore CanUndo="_session.Latest is not null" @bind-Confirming="_confirmingUndo" Question="@_session.UndoQuestion"
                             UndoDeletes="_session.UndoDeletesTheTemplate" DeleteLabel="Delete template"
                             DeleteWarning="deleting takes the template off your list." OnUndo="UndoAsync"
                             RestorableUntil="_session.RestorableUntil" Times="Times" OnRestore="RestoreAsync" />
            </section>

            @if (advice.Count > 0)
            {
                <section class="card">
                    <h2>What the checks will say</h2>
                    <p class="field-help">About every campaign from this template. It can still be saved.</p>
                    <ul class="advice">
                        @foreach (var item in advice)
                        {
                            <li>
                                <strong>@(item.Severity == Severity.Blocker ? "Blocks" : "Warns") · @item.Location</strong>
                                <br />@item.Message
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="card preview-beside" id="template-preview" data-testid="template-preview">
                <h2>Preview</h2>
                <p class="field-help">The email's blocks as Square will show them. Grey text is what each campaign fills in; what each campaign starts with shows as it is, and each campaign can change it.</p>
                <EmailPreview Blocks="editor.Preview()" Library="_photos" />
            </section>
        </aside>
    </div>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>A template to start from as a copy, for /templates/new?from={id}.</summary>
    [SupplyParameterFromQuery]
    public Guid? From { get; set; }

    private string? _denied;
    private bool _missing;
    private CampaignStore? _store;
    private TemplateSession? _session;
    // A template whose every save is undone, while it can still be restored.
    private SaveRef? _undone;
    private CampaignPolicy _policy = CampaignPolicy.Default;
    private TemplateBaseline _baseline = TemplateBaseline.None;
    private IReadOnlyList<LibraryImage> _photos = [];
    private KnownItems _known = KnownItems.None;
    private string? _message;
    private bool _confirmingUndo;
    // In the client's own zone, once it is known.
    private LocalTime? _times;
    private LocalTime Times => _times ?? Workspace.DefaultTimes;

    private string Title => _session?.Editor.Name is { Length: > 0 } name ? name : "New template";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Starting a campaign is the Campaigns feature, granted apart from this page's Templates.
    private bool _canStartCampaigns;

    protected override async Task OnInitializedAsync()
    {
        var (client, reason) = await Workspace.ClientDataAsync();
        if (client is null)
        {
            _denied = reason;
            return;
        }
        if (AuthenticationState is not null)
            _canStartCampaigns = (await Authorization.AuthorizeAsync((await AuthenticationState).User, Features.Campaigns)).Succeeded;

        _times = await Workspace.TimesAsync(client);
        var actor = await Workspace.ActorAsync();
        var store = _store = Stores.Campaigns(client, actor);
        _baseline = (await Stores.BaselineInForceAsync(client)).Baseline;
        // A new template starts with the parts every template should have; a copy starts from its template.
        _session = Id is { } id ? await TemplateSession.OpenAsync(store, id, Blocks)
            : From is { } from ? await TemplateSession.CopyAsync(store, from, Blocks)
            : TemplateSession.New(store, _baseline, Blocks);
        if (_session is null && Id is { } undoneId) _undone = await TemplateSession.RestorableAsync(store, undoneId);
        _missing = _session is null && _undone is null;
        _policy = await Stores.PolicyInForceAsync(client);
        _photos = await Stores.Images(client, actor).ListAsync();
        // Offered while an offer or a promotion to start with is written, as on the campaign page. They
        // help and nothing more, so a page that cannot read them goes on without them.
        try
        {
            _known = await Workspace.Known.ForClientAsync(client);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogError(ex, "Could not read the known items of {Client}; the template page goes on without them.", client.Value);
        }
        // What the template was just opened with is storage's as of now; listening and the timer start
        // once the page is live (WatchedComponent), never while it is rendered ahead of time.
        Watch(_session);
    }

    // "Load the latest": the template as storage has it now, replacing what is on the page, unsaved
    // edits included. Only ever on her click.
    private Task LoadLatestAsync() => ActingAsync(async () =>
    {
        _confirmingUndo = false;
        var id = _session!.Id!.Value;
        _session = await TemplateSession.OpenAsync(_store!, id, Blocks);
        Watch(_session);
        if (_session is not null)
        {
            _message = "The latest version is open.";
            return;
        }
        // Every save undone meanwhile: the page offers Restore, as on opening a deleted template.
        _message = null;
        _undone = await TemplateSession.RestorableAsync(_store!, id);
        _missing = _undone is null;
    });

    private Task SaveAsync() => ActingAsync(async () =>
    {
        var isNew = _session!.Id is null;
        var saved = await _session.SaveAsync();
        // A template saved for the first time is watched from now.
        if (isNew) Watch(_session);
        _message = $"Saved at {Times.TimeOfDay(saved.SavedAt)}.";
        _confirmingUndo = false;
        // The address now names the template, so a reload opens what was saved.
        if (isNew) Navigation.NavigateTo($"templates/{saved.Id}", replace: true);
    });

    // Undo marks the save for deletion; nothing is deleted here, or by leaving the page. Only the version
    // on the page, while storage still has it as the newest: otherwise nothing is undone, and the page
    // says why and, once the read after it is done, what changed.
    private Task UndoAsync() => ActingAsync(async () =>
    {
        _confirmingUndo = false;
        bool left;
        try
        {
            left = await _session!.UndoLastSaveAsync();
        }
        catch (CampaignChangedException ex)
        {
            _message = ex.Message;
            return;
        }
        if (left)
        {
            _message = "The last save was undone; the version before it is open.";
            return;
        }
        // Nothing left in use: the template is gone from the list, and can still be restored.
        _undone = _session.Restorable;
        _session = null;
        Watch(null);
        _message = null;
        _missing = _undone is null;
    });

    private Task RestoreAsync() => ActingAsync(async () =>
    {
        _confirmingUndo = false;
        _message = await _session!.RestoreAsync()
            ? "The undone save is back and open."
            : "That save can no longer be restored.";
    });

    private Task RestoreUndoneAsync() => ActingAsync(async () =>
    {
        _session = await TemplateSession.RestoreAsync(_store!, _undone!, Blocks);
        Watch(_session);
        _undone = null;
        _missing = _session is null;
        if (_session is not null) _message = "The undone save is back and open.";
    });
}
