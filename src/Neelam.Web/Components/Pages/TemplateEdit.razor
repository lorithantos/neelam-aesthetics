@page "/templates/new"
@page "/templates/{Id:guid}"
@* Changing a client's layouts is its own feature, apart from writing campaigns; the access
   check decides whose templates, on top of the policy. *@
@attribute [Authorize(Policy = Features.Templates)]
@rendermode InteractiveServer
@inject ClientWorkspace Workspace
@inject ClientStores Stores
@inject NavigationManager Navigation

<PageTitle>@Title</PageTitle>

@if (_denied is not null)
{
    <h1>Templates</h1>
    <p>You cannot change templates here: @_denied.</p>
}
else if (_missing)
{
    <h1>Template not found</h1>
    <p>There is no saved template here. It may have been deleted. <a href="templates">Back to templates</a></p>
}
else if (_undone is not null)
{
    <h1>@_undone.Title</h1>
    <p>Its last save was undone, so it is gone from your templates. You can restore it until
        @Times.DateAndTime(_store!.RestorableUntil(_undone)!.Value); after that it is deleted for good.</p>
    <button class="button primary" @onclick="RestoreUndoneAsync">Restore</button>
    <a class="button" href="templates">Back to templates</a>
}
else if (_session is not null)
{
    var editor = _session.Editor;
    var errors = editor.Errors();
    var advice = editor.Advice(_policy, _photos.Select(p => p.Name).ToList());
    var missing = editor.Missing(_baseline);

    <h1>@Title</h1>
    <p><a href="templates">Back to templates</a></p>

    <div class="workspace">
        <div class="workspace-main">
            <div class="field">
                <label for="template-name">Template name</label>
                <input id="template-name" @bind="editor.Name" @bind:event="oninput" />
                <span class="field-help">What people choose when they start a campaign, such as "Membership announcement".</span>
            </div>

            <h2>Blocks, top to bottom</h2>
            @if (editor.FromBaseline && _session.Id is null)
            {
                <p class="field-help">Started with the parts every template should have. <a href="templates#baseline-heading">Change that list on the Templates page.</a></p>
            }
            @if (editor.Blocks.Count == 0)
            {
                <p class="muted">No blocks yet. Add them below in the order the email shows them.</p>
            }
            @for (var i = 0; i < editor.Blocks.Count; i++)
            {
                var index = i;
                var block = editor.Blocks[index];
                var guide = BlockGuide.For(block.Type);
                <section class="card block-card" aria-label="@block.Label">
                    <div class="block-card-head">
                        <h3>@guide.Name</h3>
                        <div class="block-actions">
                            <button class="button" disabled="@(index == 0)" aria-label="Move @block.Label up" @onclick="() => editor.MoveUp(block)">Up</button>
                            <button class="button" disabled="@(index == editor.Blocks.Count - 1)" aria-label="Move @block.Label down" @onclick="() => editor.MoveDown(block)">Down</button>
                            <button class="button danger" aria-label="Remove @block.Label" @onclick="() => editor.Remove(block)">Remove</button>
                        </div>
                    </div>
                    <p class="field-help">@guide.Purpose</p>

                    <div class="field">
                        <label for="label-@index">Label</label>
                        <input id="label-@index" @bind="block.Label" @bind:event="oninput" />
                        <span class="field-help">How the checks name this block when they find something.</span>
                    </div>

                    @if (block.CanBeFixed)
                    {
                        <label class="check"><input type="checkbox" @bind="block.IsFixed" /> The same in every campaign</label>
                    }
                    @if (!block.IsFixed && block.Type != BlockType.Spacer)
                    {
                        <label class="check"><input type="checkbox" @bind="block.Required" /> Every campaign must fill it</label>
                    }

                    @if (block.Type == BlockType.Offer)
                    {
                        <label class="check"><input type="checkbox" @bind="block.Recurring" /> Customers are charged every month</label>
                        <div class="field">
                            <label for="marker-@index">Benefit marker</label>
                            <input id="marker-@index" @bind="block.Marker" @bind:event="oninput" />
                            <span class="field-help">What starts each benefit line, such as 🤍. Left blank, a bullet (•).</span>
                        </div>
                    }

                    @if (block.IsFixed)
                    {
                        @switch (block.Type)
                        {
                            case BlockType.Heading:
                            case BlockType.Greeting:
                                <div class="field">
                                    <label for="text-@index">@(block.Type == BlockType.Heading ? "Heading" : "Greeting")</label>
                                    <input id="text-@index" @bind="block.Text" @bind:event="oninput" />
                                </div>
                                break;
                            case BlockType.FinePrint:
                                <div class="field">
                                    <label for="text-@index">Fine print</label>
                                    <textarea id="text-@index" @bind="block.Text" @bind:event="oninput"></textarea>
                                </div>
                                break;
                            case BlockType.Paragraphs:
                                <div class="field">
                                    <label for="paragraphs-@index">Paragraphs</label>
                                    <textarea id="paragraphs-@index" @bind="block.Paragraphs" @bind:event="oninput"></textarea>
                                    <span class="field-help">Leave a blank line between paragraphs.</span>
                                </div>
                                break;
                            case BlockType.Header:
                                <div class="field">
                                    <label for="text-@index">Business name</label>
                                    <input id="text-@index" @bind="block.Text" @bind:event="oninput" />
                                </div>
                                <PhotoFields Block="block" Index="index" Photos="_photos" Optional="true" />
                                break;
                            case BlockType.Image:
                                <PhotoFields Block="block" Index="index" Photos="_photos" Optional="false" />
                                break;
                            case BlockType.Button:
                                <div class="field">
                                    <label for="button-label-@index">Button text</label>
                                    <input id="button-label-@index" @bind="block.ButtonLabel" @bind:event="oninput" />
                                </div>
                                <div class="field">
                                    <label for="button-url-@index">Link</label>
                                    <input id="button-url-@index" type="url" @bind="block.ButtonUrl" @bind:event="oninput" />
                                    <span class="field-help">The full address, starting https://.</span>
                                </div>
                                break;
                            case BlockType.SignOff:
                                <div class="field">
                                    <label for="valediction-@index">Valediction</label>
                                    <input id="valediction-@index" @bind="block.Valediction" @bind:event="oninput" />
                                    <span class="field-help">Such as "With love,".</span>
                                </div>
                                <div class="field">
                                    <label for="from-@index">From</label>
                                    <input id="from-@index" @bind="block.From" @bind:event="oninput" />
                                </div>
                                <div class="field">
                                    <label for="tagline-@index">Tagline (optional)</label>
                                    <input id="tagline-@index" @bind="block.Tagline" @bind:event="oninput" />
                                </div>
                                break;
                        }
                    }

                    @if (guide.Checks.Count > 0)
                    {
                        <details>
                            <summary>What the checks look for in this block</summary>
                            <ul>
                                @foreach (var check in guide.Checks)
                                {
                                    <li>@check</li>
                                }
                            </ul>
                        </details>
                    }
                </section>
            }

            <h2>Add a block</h2>
            <div class="add-blocks">
                @foreach (var guide in BlockGuide.All)
                {
                    <button class="button add-block" @onclick="() => editor.Add(guide.Type)">
                        <strong>@guide.Name</strong>
                        <span>@guide.Purpose</span>
                    </button>
                }
            </div>
        </div>

        <aside class="workspace-side">
            <section class="card">
                <h2>Save</h2>
                <Problems Messages="@errors.Select(e => $"{e.Where}: {e.Message}").ToList()" />
                @if (missing.Count > 0)
                {
                    @* The baseline warns and never blocks: a short note may rightly lack a part. *@
                    <ul class="advice" aria-label="Parts this template lacks">
                        @foreach (var gap in missing)
                        {
                            <li>@gap.Message</li>
                        }
                    </ul>
                    <p class="field-help">It can still be saved. The parts every template should have are listed under <a href="templates">Templates</a>.</p>
                }
                <button class="button primary" disabled="@(errors.Count > 0)" @onclick="SaveAsync">Save template</button>
                @if (_message is not null)
                {
                    <p role="status">@_message</p>
                }
                @if (_session.Latest is { } latest)
                {
                    <p class="muted">Last saved @Times.DateAndTime(latest.SavedAt).</p>
                    @if (_confirmingUndo)
                    {
                        <p>Undo the last save? The version before it comes back, and any changes not saved are lost. The undone version can be restored for @Period(_store!.UndoGracePeriod), then it is deleted for good.</p>
                        <button class="button danger" @onclick="UndoAsync">Undo it</button>
                        <button class="button" @onclick="() => _confirmingUndo = false">Keep it</button>
                    }
                    else
                    {
                        <button class="button" @onclick="() => _confirmingUndo = true">Undo last save</button>
                    }
                }
                @if (_session.Restorable is not null)
                {
                    <p class="field-help">The last undo can be taken back until @Times.DateAndTime(_session.RestorableUntil!.Value).</p>
                    <button class="button" @onclick="RestoreAsync">Restore undone save</button>
                }
            </section>

            @if (advice.Count > 0)
            {
                <section class="card">
                    <h2>What the checks will say</h2>
                    <p class="field-help">About every campaign from this template. It can still be saved.</p>
                    <ul class="advice">
                        @foreach (var item in advice)
                        {
                            <li>
                                <strong>@(item.Severity == Severity.Blocker ? "Blocks" : "Warns") · @item.Location</strong>
                                <br />@item.Message
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="card">
                <h2>Preview</h2>
                <p class="field-help">The email's blocks as Square will show them. Grey text is what each campaign fills in.</p>
                <EmailPreview Blocks="editor.Preview()" Library="_photos" />
            </section>
        </aside>
    </div>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>A template to start from as a copy, for /templates/new?from={id}.</summary>
    [SupplyParameterFromQuery]
    public Guid? From { get; set; }

    private string? _denied;
    private bool _missing;
    private CampaignStore? _store;
    private TemplateSession? _session;
    // A template whose every save is undone, while it can still be restored.
    private SaveRef? _undone;
    private CampaignPolicy _policy = CampaignPolicy.Default;
    private TemplateBaseline _baseline = TemplateBaseline.None;
    private IReadOnlyList<LibraryImage> _photos = [];
    private string? _message;
    private bool _confirmingUndo;
    // In the client's own zone, once it is known.
    private LocalTime? _times;
    private LocalTime Times => _times ?? Workspace.DefaultTimes;

    private string Title => _session?.Editor.Name is { Length: > 0 } name ? name : "New template";

    protected override async Task OnInitializedAsync()
    {
        var (client, reason) = await Workspace.ClientDataAsync();
        if (client is null)
        {
            _denied = reason;
            return;
        }

        _times = await Workspace.TimesAsync(client);
        var actor = await Workspace.ActorAsync();
        var store = _store = Stores.Campaigns(client, actor);
        _baseline = (await Stores.BaselineInForceAsync(client)).Baseline;
        // A new template starts with the parts every template should have; a copy starts from its template.
        _session = Id is { } id ? await TemplateSession.OpenAsync(store, id)
            : From is { } from ? await TemplateSession.CopyAsync(store, from)
            : TemplateSession.New(store, _baseline);
        if (_session is null && Id is { } undoneId) _undone = await TemplateSession.RestorableAsync(store, undoneId);
        _missing = _session is null && _undone is null;
        _policy = await Stores.PolicyInForceAsync(client);
        _photos = await Stores.Images(client, actor).ListAsync();
    }

    private async Task SaveAsync()
    {
        var isNew = _session!.Id is null;
        var saved = await _session.SaveAsync();
        _message = $"Saved at {Times.TimeOfDay(saved.SavedAt)}.";
        _confirmingUndo = false;
        // The address now names the template, so a reload opens what was saved.
        if (isNew) Navigation.NavigateTo($"templates/{saved.Id}", replace: true);
    }

    // Undo marks the save for deletion; nothing is deleted here, or by leaving the page.
    private async Task UndoAsync()
    {
        _confirmingUndo = false;
        if (await _session!.UndoLastSaveAsync())
        {
            _message = "The last save was undone; the version before it is open.";
            return;
        }
        // Nothing left in use: the template is gone from the list, and can still be restored.
        _undone = _session.Restorable;
        _session = null;
        _message = null;
        _missing = _undone is null;
    }

    private async Task RestoreAsync()
    {
        _confirmingUndo = false;
        _message = await _session!.RestoreAsync()
            ? "The undone save is back and open."
            : "That save can no longer be restored.";
    }

    private async Task RestoreUndoneAsync()
    {
        _session = await TemplateSession.RestoreAsync(_store!, _undone!);
        _undone = null;
        _missing = _session is null;
        if (_session is not null) _message = "The undone save is back and open.";
    }

    // The grace period in words, such as "24 hours".
    private static string Period(TimeSpan period) =>
        period.TotalHours >= 1 ? $"{period.TotalHours:0.#} hours" : $"{period.TotalMinutes:0} minutes";
}
