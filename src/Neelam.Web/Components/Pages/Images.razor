@page "/images"
@* The client's image library: the photos her templates and campaigns name. A photo can be one
   hosted on Square, by its address there (owner, 2026-10-09): her images live in Square's library,
   so the preview shows Square's own copy and nothing is copied here. The access check decides
   whose library, on top of the policy. *@
@attribute [Authorize(Policy = Features.Campaigns)]
@rendermode InteractiveServer
@inject ClientWorkspace Workspace
@inject ClientStores Stores

<PageTitle>Image library</PageTitle>

<h1>Image library</h1>

@if (_denied is not null)
{
    <p>You cannot see the image library here: @_denied.</p>
}
else if (_images is not null)
{
    <p class="muted">Photos for @_displayName. A photo block in a template or campaign names one of these by its name.</p>

    @if (_message is not null)
    {
        <p role="status" class="library-status">@_message</p>
    }

    @if (_images.Count == 0)
    {
        <p>No photos yet. Add one from Square below.</p>
    }
    @foreach (var image in _images)
    {
        <section class="card" aria-label="@image.Name">
            @* Delete sits beside the name, away from the image, and its confirmation opens right
               under the name, above the image, so it is in view where the click was. *@
            <div class="library-entry-head">
                <h2>@image.Name</h2>
                @if (_confirming != image.Name)
                {
                    <button class="button" @onclick="() => _confirming = image.Name">Delete</button>
                }
            </div>
            @if (_confirming == image.Name)
            {
                <div class="confirm" role="alert">
                    <p>@(image.IsOnSquare || image.NotASquareAddress
                        ? "Delete this photo from the library? Only the reference here goes; nothing at Square is touched. Blocks that name it will no longer find it."
                        : "Delete this photo? It is deleted for good. Blocks that name it will no longer find it.")</p>
                    <button class="button danger" @onclick="() => DeleteAsync(image)">Delete it</button>
                    <button class="button" @onclick="() => _confirming = null">Keep it</button>
                </div>
            }
            @if (image.NotASquareAddress)
            {
                @* Never shown as an image: its stored address is not on one of Square's hosts. *@
                <p class="problem">@NotASquareAddress</p>
            }
            else if (image.SquareUrl is { } url)
            {
                <img class="library-image" src="@url.AbsoluteUri" alt="@image.Name" />
                <details class="library-address">
                    <summary>Square address</summary>
                    <span>@url.AbsoluteUri</span>
                </details>
            }
            else
            {
                <p class="muted">Uploaded@(image.AddedAt > DateTimeOffset.MinValue ? $" {image.AddedAt:d MMM yyyy}" : "").</p>
            }
        </section>
    }

    <h2>Add from Square</h2>
    <section class="card">
        <p class="field-help">
            In your Square image library, copy the image's address. Only addresses on Square's own image
            hosts are accepted. Any size or crop in the address is kept, so the photo shows as Square will
            send it. Nothing is copied here: the library keeps the name and the address, and deleting it
            later removes only that, never anything at Square.
        </p>
        <div class="field">
            <label for="square-name">Name</label>
            <input id="square-name" @bind="_newName" />
            <span class="field-help">What blocks call it, such as "Principals toasting".</span>
        </div>
        <div class="field">
            <label for="square-url">Address on Square</label>
            <input id="square-url" type="url" @bind="_newAddress" />
            <span class="field-help">Starts https://, on @string.Join(", ", ImageLibrary.SquareHosts).</span>
        </div>
        <Problems Messages="_errors" />
        <button class="button primary" @onclick="AddFromSquareAsync">Add from Square</button>
        @if (_added is not null)
        {
            <p role="status">@_added</p>
        }
    </section>
}

@code {
    /// <summary>What an entry whose stored address is not on Square's hosts says, in place of its image.</summary>
    public const string NotASquareAddress = "Not a Square address — remove it. It is not shown, and blocks that name it show no photo.";

    private string? _added;
    private string? _denied;
    private ImageLibrary? _library;
    private string? _displayName;
    private IReadOnlyList<LibraryImage>? _images;
    private string? _newName;
    private string? _newAddress;
    private IReadOnlyList<string> _errors = [];
    private string? _message;
    private string? _confirming;

    protected override async Task OnInitializedAsync()
    {
        var (client, reason) = await Workspace.ClientDataAsync();
        if (client is null)
        {
            _denied = reason;
            return;
        }
        _displayName = await Workspace.DisplayNameAsync(client);
        _library = Stores.Images(client, await Workspace.ActorAsync());
        _images = await _library.ListAsync();
    }

    private async Task AddFromSquareAsync()
    {
        _added = _message = null;
        try
        {
            var added = await _library!.AddFromSquareAsync(_newName ?? "", _newAddress ?? "");
            _errors = [];
            _added = $"Added \"{added.Name}\".";
            _newName = _newAddress = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errors = [ex.Message];
            return;
        }
        _images = await _library.ListAsync();
    }

    private async Task DeleteAsync(LibraryImage image)
    {
        _confirming = null;
        _added = null;
        await _library!.DeleteAsync(image.Name);
        _message = image.IsOnSquare ? $"\"{image.Name}\" is out of the library. The image is still in your Square library."
            : image.NotASquareAddress ? $"\"{image.Name}\" is out of the library."
            : $"\"{image.Name}\" is deleted.";
        _images = await _library.ListAsync();
    }
}
