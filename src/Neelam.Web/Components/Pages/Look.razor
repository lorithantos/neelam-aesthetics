@page "/look"
@* Her pages' colours (owner, 2026-10-09: "let's make the page look a little more like what an
   Aesthetician would like -- maybe a light pink background and something softer than white for the
   main editing"). The look is data, saved in settings/{client}/, as the baseline and ladders are her
   own: "Save" keeps hers as a new version, and "Use the standard look" saves one that says so, so her
   earlier looks stay listed to use again (owner, 2026-10-09: "We should allow it to be restored after
   a set of edits, no?"). "Undo last save" marks the newest undone, restorable for the grace period, as
   the editors do. The access check decides whose look, on top of the policy; the look is not client
   data, so the operator needs no grant for it. Another tab or person may change her look while this
   page is open (2026-10-11, phase 2): PageWatch tells the page, and Undo takes back only the look this
   page shows as the newest, read again at the click. Save is not checked yet (phase 3). *@
@attribute [Authorize(Policy = Features.Look)]
@rendermode InteractiveServer
@inherits WatchedComponent<DocumentVersion>
@implements IHandleEvent
@inject ClientWorkspace Workspace
@inject ClientStores Stores
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject EditingTabs OpenTabs
@inject TabCircuit Circuit

<PageTitle>Look</PageTitle>

<h1>Look</h1>

@if (_denied is not null)
{
    <p>You cannot change the look here: @_denied.</p>
}
else if (_fields is not null)
{
    var chosen = Chosen();
    var problems = chosen.Palette.ContrastProblems();
    <p class="muted" data-testid="look-status">@(_history!.IsOwn ? "Your own look." : "The standard look.")
        These colours are for your pages here, not for your emails: Square sends those as you set them up there.</p>

    @if (SavedMessage() is { } saved)
    {
        <p role="status" data-testid="look-saved">@saved</p>
    }

    @* The owner's "modified" (2026-10-11), as on the campaign page, without Keep mine. The colours she
       chose here stay until she loads the latest, which loads the page again. *@
    <ModifiedNotice Words="ChangeWords.Look" Change="StorageChange" OnLoadLatest="LoadLatest"
                    Unsaved="Loading the latest replaces any colours you changed here and have not saved." />
    @* Another tab on her look has done something since this one opened (2026-11-05), said as soon as it
       does, as on the campaign page; a card as the notice above is, said politely. *@
    @if (_tab?.OthersEditing == true)
    {
        <section class="card" role="status" data-testid="other-tab-notice"><p>@ChangeWords.OtherTab</p></section>
    }

    <div class="workspace">
        <section class="workspace-main card" aria-labelledby="colours-heading">
            <h2 id="colours-heading">Colours</h2>
            @foreach (var field in _fields)
            {
                var f = field;
                <div class="field look-colour">
                    <label for="look-@f.Id">@f.Name</label>
                    <span class="look-colour-inputs">
                        <input type="color" id="look-@f.Id" value="@f.Value" aria-describedby="look-@f.Id-help"
                               @onchange="e => Set(f, e.Value as string)" />
                        <input type="text" class="look-hex" aria-label="@f.Name as # and six hex digits" value="@f.Value"
                               data-testid="look-hex-@f.Id" spellcheck="false" maxlength="7"
                               @onchange="e => Set(f, e.Value as string)" />
                    </span>
                    <span class="field-help" id="look-@f.Id-help">@f.Help</span>
                    @if (f.Error is not null)
                    {
                        <span class="validation-message">@f.Error</span>
                    }
                </div>
            }
        </section>

        <section class="workspace-side" aria-labelledby="sample-heading">
            <h2 id="sample-heading">Sample</h2>
            @* Drawn with the same custom properties as every page, every one set from the colours above,
               so nothing comes through from the look this page itself is drawn in. *@
            <div class="look-sample" data-testid="look-sample" style="@LookStyle.Declarations(chosen.Palette)">
                <div class="card">
                    <p>Text as you write it.</p>
                    <p class="muted">Help and dates, a little quieter.</p>
                    <p><a href="look" @onclick:preventDefault>A link</a></p>
                    <span class="button primary">Save</span>
                </div>
            </div>

            @if (problems.Count > 0)
            {
                <ul class="errors" data-testid="look-problems">
                    @foreach (var problem in problems)
                    {
                        <li>@problem</li>
                    }
                </ul>
            }
            <p>
                <button class="button primary" data-testid="look-save" disabled="@(problems.Count > 0)" @onclick="SaveAsync">Save</button>
                @if (_history!.Versions.FirstOrDefault() is { Look: not { IsStandard: true } })
                {
                    <button class="button" data-testid="look-use-standard" @onclick="UseStandardAsync">Use the standard look</button>
                }
            </p>
            @if (_message is not null)
            {
                <p role="status" data-testid="look-message">@_message</p>
            }
            @* Undoing her only look never deletes anything she sees: the standard look is in force again. *@
            <UndoRestore CanUndo="_history.Versions.Count > 0" @bind-Confirming="_confirmingUndo"
                         Question="@ChangeWords.Look.UndoQuestion(_history.UndoGracePeriod)" OnUndo="UndoAsync"
                         RestorableUntil="_history.RestorableUntil" Times="Times" OnRestore="RestoreAsync" RestoreLabel="Restore undone look"
                         UndoId="look-undo" ConfirmId="look-undo-confirm" RestorableId="look-restorable" RestoreId="look-restore" />
        </section>
    </div>

    <section class="card" aria-labelledby="earlier-heading">
        <h2 id="earlier-heading">Earlier looks</h2>
        @if (_history.Versions.Count == 0)
        {
            <p class="muted" data-testid="earlier-looks-none">You have not saved a look of your own yet.</p>
        }
        else
        {
            <p class="field-help">Your last @ClientStores.EarlierLooksListed saves, newest first. Using one again saves it as your newest look; the others stay here.</p>
            <ol class="earlier-looks">
                @foreach (var version in _history.Versions)
                {
                    var v = version;
                    <li class="earlier-look" data-testid="earlier-look-@v.Id">
                        <span class="earlier-look-when" data-testid="earlier-look-when-@v.Id">@Times.DateAndTime(v.Version.SavedAt)</span>
                        @if (v.Look is { } look)
                        {
                            <span class="look-swatches">
                                @foreach (var (id, name, hex) in Swatches(look.Palette))
                                {
                                    <span class="look-swatch" style="background-color:@hex" data-testid="earlier-look-swatch-@v.Id-@id"><span class="visually-hidden">@name @hex</span></span>
                                }
                            </span>
                            @if (look.IsStandard)
                            {
                                <span data-testid="earlier-look-standard-@v.Id">Standard look</span>
                            }
                        }
                        @if (v.InUse)
                        {
                            <strong data-testid="earlier-look-state-@v.Id">In use</strong>
                        }
                        else if (v.Look is null)
                        {
                            <span class="muted" data-testid="earlier-look-state-@v.Id">Can't be used</span>
                        }
                        else
                        {
                            <button class="button" data-testid="earlier-look-use-@v.Id" @onclick="() => UseAgainAsync(v)">Use this look again</button>
                        }
                    </li>
                }
            </ol>
        }
    </section>
}

@code {
    /// <summary>
    /// What was just done, since the page loads again after each change: "own" after a save, "standard"
    /// after going back to the standard look, "again" after using an earlier look again, "undone" and
    /// "restored" after an undo and its restore.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? Saved { get; set; }

    /// <summary>
    /// This page was loaded again by her own action in the page before it (?acted=1): a mark that carries
    /// nothing, set only by her click, so the page that opens tells the other tabs once (2026-11-05). Text, not
    /// a bool, so an address typed with anything else there still opens the page; only "1" is the mark.
    /// </summary>
    [SupplyParameterFromQuery(Name = ActedMark)]
    public string? Acted { get; set; }

    private const string ActedMark = "acted";

    // Whether this page has told the other tabs of the action that loaded it.
    private bool _actedTold;

    private string? _denied;
    private ClientName? _client;
    private LookHistory? _history;
    private LocalTime? _times;
    private LocalTime Times => _times ?? Workspace.DefaultTimes;
    private IReadOnlyList<ColourField>? _fields;
    private string? _message;
    private bool _confirmingUndo;

    private string? SavedMessage() => Saved switch
    {
        "own" => "Saved. Every page now has your look.",
        "standard" => "Every page has the standard look again. Your earlier looks are kept below, to use again.",
        "again" => "Saved as your newest look. Every page now has it again.",
        "undone" => "The last save was undone; your pages have the look before it.",
        "restored" => "The undone look is back on every page.",
        _ => null,
    };

    // The six colours of a look as a strip, each named for a screen reader.
    private static IEnumerable<(string Id, string Name, string Hex)> Swatches(LookPalette palette) =>
    [
        ("background", "Page background", palette.PageBackground),
        ("surface", "Editing surface", palette.Surface),
        ("border", "Borders", palette.Border),
        ("text", "Text", palette.Text),
        ("muted", "Quieter text", palette.MutedText),
        ("accent", "Accent", palette.Accent),
    ];

    // One colour of the look: what it is called here, and what she has chosen (the standard's until she
    // changes it).
    private sealed class ColourField(string id, string name, string help, string standard, string? own)
    {
        public string Id => id;
        public string Name => name;
        public string Help => help;
        public string Standard => standard;
        public string Value { get; set; } = own ?? standard;
        public string? Error { get; set; }

        // A colour left at the standard's is not hers: it follows the standard.
        public string? Own => string.Equals(Value, Standard, StringComparison.OrdinalIgnoreCase) ? null : Value;
    }

    protected override async Task OnInitializedAsync()
    {
        (_client, var reason) = await Workspace.LookClientAsync();
        if (_client is null)
        {
            _denied = reason;
            return;
        }
        // Made here, opened only once the page is live (OnAfterRender), never while rendered ahead of time.
        _tab = new EditingTabNotice(OpenTabs, Circuit, OnCircuitAsync, Logs.CreateLogger<EditingTabNotice>());
        _times = await Workspace.TimesAsync(_client);
        _history = await Stores.LookHistoryAsync(_client);
        // The newest look this page shows (her newest, readable or not), which Undo acts on and the
        // watch tells a change from; listening and the timer start once the page is live.
        _held = Stores.HoldLook(_client, _history.Versions.FirstOrDefault()?.Version);
        Watch(_held);
        // The look in force: hers, the standard one she went back to, or none (the standard's).
        var look = _history.InForce ?? ClientLook.Default;
        var standard = LookPalette.Standard;
        _fields =
        [
            new("background", "Page background", "Behind everything.", standard.PageBackground, look.PageBackground),
            new("surface", "Editing surface", "The cards and panels you write in.", standard.Surface, look.Surface),
            new("border", "Borders", "Around cards and blocks.", standard.Border, look.Border),
            new("text", "Text", "What you read and write.", standard.Text, look.Text),
            new("muted", "Quieter text", "Help, dates and notes.", standard.MutedText, look.MutedText),
            new("accent", "Accent", "Links and the main buttons, such as Save.", standard.Accent, look.AccentColour),
        ];
    }

    private ClientLook Chosen()
    {
        string? Own(string id) => _fields!.Single(f => f.Id == id).Own;
        return new ClientLook(
            accentColour: Own("accent"), pageBackground: Own("background"), surface: Own("surface"), border: Own("border"),
            text: Own("text"), mutedText: Own("muted"));
    }

    private void Set(ColourField field, string? value)
    {
        value = value?.Trim();
        if (!ClientLook.IsColour(value))
        {
            field.Error = "Write a colour as # and six hex digits, such as #faf0f2.";
            return;
        }
        field.Value = value!.ToLowerInvariant();
        field.Error = null;
        _message = null;
    }

    // Her look as this page shows it, which the page's look at storage watches.
    private HeldDocument? _held;

    // This tab among the tabs open on her client's look (2026-11-05), so another tab's editing is said at once.
    // Null until the page knows its client.
    private EditingTabNotice? _tab;

    // Live on its circuit, the watch started (WatchedComponent.OnAfterRender), never while rendered ahead of
    // time: the tab is open on the look of the client the page shows, whose one look it is.
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (_client is not { } client || _fields is null) return;
        _tab?.Open(client, TabSubject.Look);
        // Loaded again by her own action, which closed the page before this one and its tab with it: told
        // once more from here, the one render that tells, since only her click sets the mark. The mark comes
        // off the address without loading the page again, so a reload of hers or a link to it tells no one.
        if (Acted != "1" || _actedTold) return;
        _actedTold = true;
        _tab?.Typed();
        _ = ShowAddressAsync(Navigation.GetUriWithQueryParameter(ActedMark, (string?)null));
    }

    // The browser's address, replaced in place, as CampaignEdit does after a first save: navigating, even to
    // replace the entry, is an enhanced navigation that loads this page afresh, closing this tab and so
    // clearing the other tab's notice. A failure is only logged: the address keeps a mark that does no harm,
    // since this page tells once.
    private async Task ShowAddressAsync(string address)
    {
        try
        {
            await JS.InvokeVoidAsync("history.replaceState", null, "", address);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Logs.CreateLogger<Look>().LogWarning(ex, "Could not take the mark off the look's address.");
        }
    }

    // Each action loads the page again (the look is drawn in each page's head), marked as hers.
    private static string Marked(string address) => $"{address}{(address.Contains('?') ? '&' : '?')}{ActedMark}=1";

    // Everything she does here is editing (owner, 2026-11-05: "It feels weird not to count loading - that's a
    // serious update, no? Just as undo is (since that's effectively a reload as is Restore)"): each colour she
    // changes and each action, Save, Undo, Restore and Load the latest among them, tells the other tabs on
    // her look once it has run. An action then loads the page again, closing this tab; the page it loads,
    // marked as hers, tells them again once it is open (OnAfterRender). Only she makes events: opening, the
    // watch and another tab's news draw the page without one.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) =>
        HandleHerEventAsync(callback, arg, () => _tab?.Typed());

    protected override void Disposing() => _tab?.Dispose();

    // One of the page's own changes: what storage says meanwhile is not news. A change that is made loads
    // the page again (the look is drawn in each page's head); one refused leaves it, read again.
    private Task ActingAsync(Func<Task<string?>> action) =>
        ActingAsync(action, address => Navigation.NavigateTo(Marked(address), forceLoad: true));

    // "Load the latest": the page as it would open now. Only ever on her click.
    private void LoadLatest() => Navigation.NavigateTo(Marked("look"), forceLoad: true);

    private Task SaveAsync() => ActingAsync(async () =>
    {
        try
        {
            await Stores.SaveLookAsync(_client!, Chosen(), await Workspace.ActorAsync());
        }
        catch (ArgumentException ex)
        {
            _message = ex.Message;
            return null;
        }
        // The look is in each page's head, drawn when the page loads, so this one loads again to show it.
        return "look?saved=own";
    });

    private Task UseStandardAsync() => ActingAsync(async () =>
    {
        await Stores.UseStandardLookAsync(_client!, await Workspace.ActorAsync());
        return "look?saved=standard";
    });

    // A copy, saved as the newest version; the earlier one stays as it was.
    private Task UseAgainAsync(LookVersion earlier) => ActingAsync(async () =>
    {
        try
        {
            await Stores.UseLookAgainAsync(_client!, earlier.Version, await Workspace.ActorAsync());
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidDataException)
        {
            _message = ex.Message;
            return null;
        }
        return "look?saved=again";
    });

    // Undo marks the newest version for deletion; nothing is deleted here, or by leaving the page. Only
    // the look this page shows as the newest, while storage still has it so: otherwise nothing is undone.
    private Task UndoAsync() => ActingAsync(async () =>
    {
        _confirmingUndo = false;
        try
        {
            await Stores.UndoLastLookSaveAsync(_held!, await Workspace.ActorAsync());
        }
        catch (CampaignChangedException ex)
        {
            _message = ex.Message;
            return null;
        }
        return "look?saved=undone";
    });

    private Task RestoreAsync() => ActingAsync(async () =>
    {
        if (await Stores.RestoreLookAsync(_client!, _history!.Restorable!, await Workspace.ActorAsync()))
            return "look?saved=restored";
        _message = "That look can no longer be restored.";
        return null;
    });
}
