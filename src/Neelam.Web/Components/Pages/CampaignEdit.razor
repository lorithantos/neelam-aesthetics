@page "/campaigns/new/{TemplateId:guid}"
@page "/campaigns/{Id:guid}"
@* Writing a campaign: the access check decides whose, on top of the policy. The page only binds to
   CampaignEditor (through DraftSession); the checks shown are the rules alone, run over what is
   filled in even while parts are missing. A saved campaign with nothing left to fix can be
   approved, by name; the approval is of that save, so any edit or later save undoes it. Approving
   and exporting take the Review feature on top of Campaigns. Export needs the AI proofread, as
   EditorExport.Blocks requires, so it stays locked, except on the demo (SiteMode, which is
   Prototype access): there an approved campaign the rules pass exports through
   CampaignGate.DemoReview, every block marked as not proofread, and the same report gives the
   assistant's JSON (AssistantExport) beside the copy blocks. The offer and photo fields are
   child components, which tell the page of each change so the checks follow what is typed. The
   label at the top is the client's own name for the campaign, saved with the draft and never part
   of the email, its checks or its export. *@
@attribute [Authorize(Policy = Features.Campaigns)]
@* Streamed, so the page says it is opening the campaign as soon as it is clicked: without it, the
   list stays on screen under the campaign's address until every read is done, which reads as the
   click landing back on the list. *@
@attribute [StreamRendering]
@rendermode InteractiveServer
@inject ClientWorkspace Workspace
@inject ClientStores Stores
@inject NavigationManager Navigation
@inject SiteMode Site
@inject BlockCatalog Blocks
@inject IAuthorizationService Authorization
@inject ActivityRecorder Recorder
@inject ILogger<CampaignEdit> Log
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>

@if (_denied is not null)
{
    <h1>Campaigns</h1>
    <p>You cannot write campaigns here: @_denied.</p>
}
else if (_unreadable is not null)
{
    <h1>This campaign can't be checked yet</h1>
    <p>@_unreadable <a href="campaigns">Back to campaigns</a></p>
}
else if (_missing is not null)
{
    <h1>@(Id is null ? "This template couldn't be opened" : "This campaign couldn't be opened")</h1>
    <p>@_missing: there is nothing saved here. It may have been deleted. <a href="campaigns">Back to campaigns</a></p>
}
else if (_undone is not null)
{
    <h1>@_undone.Title</h1>
    <p>This campaign is deleted. You can restore it until
        @Times.DateAndTime(_store!.RestorableUntil(_undone)!.Value); after that it is removed for good.
        Until then it is also under Recently deleted in your campaigns.</p>
    <button class="button primary" @onclick="RestoreUndoneAsync">Restore</button>
    <a class="button" href="campaigns">Back to campaigns</a>
}
else if (_session is not null)
{
    var editor = _session.Editor;
    var errors = editor.Errors();
    var status = editor.Status(_policy, Business);
    var approval = _session.CurrentApproval;
    var cannotApprove = _session.CannotApprove(_policy, Business);
    // One gate for both forms of the export: the copy blocks and the assistant's JSON come from
    // the same report, so neither exists without the other, and both carry the approval that
    // report was made with (DraftSession.DemoExportReport: the approval in force, never the
    // latest save's, which an unsaved edit leaves in place).
    var exportReport = ExportReport();
    // Before the export, every "Worth a look" finding she has not been shown at export for this
    // version: listed with a way to each field, and one button to go on. Never a fix required.
    var warningsFirst = WarningsBeforeExport();
    var export = exportReport is null ? null : EditorExport.Blocks(exportReport);
    var assistant = exportReport is null ? null : AssistantExport.Offer(exportReport, exportReport.DemoApproval,
        new AssistantExportContext(_session.Id, editor.Label, editor.TemplateName, name => ImageLibrary.Find(_photos, name)?.SquareUrl));

    <KnownItemLists Known="Known" />
    <h1>@Title</h1>
    <p><a href="campaigns">Back to campaigns</a>@(editor.TemplateName is { } template ? $" · From the template {template}" : "")</p>

    <div class="workspace">
        <div class="workspace-main">
            <div class="field">
                <label for="label">Label (just for you)</label>
                <input id="label" @bind="editor.Label" @bind:event="oninput" />
                <span class="field-help">e.g. Beauty Bank -- first send. It names the campaign in your list, so two with the same subject can be told apart. It is never part of the email.</span>
            </div>

            <div class="field">
                <label for="subject">Subject line</label>
                <input id="subject" @bind="editor.Subject.Text" @bind:event="oninput" />
                <span class="field-help">What the reader sees in their inbox.</span>
            </div>

            <h2>The email, top to bottom</h2>
            @for (var i = 0; i < editor.Blocks.Count; i++)
            {
                var index = i;
                var block = editor.Blocks[index];
                if (block is not SpacerBlockEditor)
                {
                    <section class="card block-card" id="block-@index" aria-label="@block.Label">
                        <div class="block-card-head">
                            <h3>@block.Label</h3>
                            <span class="muted">@Blocks.For(block.Type).Label@(block.IsFixed ? " · the same in every campaign" : block.Required ? "" : " · optional")</span>
                        </div>

                        @if (block.IsFixed)
                        {
                            <p class="field-help">Written once, in the template. It goes out like this:</p>
                            <EmailPreview Blocks="block.FixedPreview" Library="_photos" />
                        }
                        else
                        {
                            @switch (block)
                            {
                                case TextBlockEditor text when block.Type == BlockType.FinePrint:
                                    <div class="field">
                                        <label for="text-@index">Fine print</label>
                                        <textarea id="text-@index" @bind="text.Field.Text" @bind:event="oninput"></textarea>
                                    </div>
                                    break;
                                case TextBlockEditor text:
                                    <div class="field">
                                        <label for="text-@index">@Blocks.For(block.Type).Label</label>
                                        <input id="text-@index" @bind="text.Field.Text" @bind:event="oninput" />
                                    </div>
                                    break;
                                case ParagraphsBlockEditor paragraphs:
                                    <div class="field">
                                        <label for="paragraphs-@index">Paragraphs</label>
                                        <textarea id="paragraphs-@index" @bind="paragraphs.Text" @bind:event="oninput"></textarea>
                                        <span class="field-help">Leave a blank line between paragraphs.</span>
                                    </div>
                                    break;
                                case ButtonBlockEditor button:
                                    <div class="field">
                                        <label for="button-label-@index">Button text</label>
                                        <input id="button-label-@index" @bind="button.ButtonLabel" @bind:event="oninput" />
                                    </div>
                                    <div class="field">
                                        <label for="button-url-@index">Link</label>
                                        <input id="button-url-@index" type="url" @bind="button.ButtonUrl" @bind:event="oninput" />
                                        <span class="field-help">The full address, starting https://.</span>
                                    </div>
                                    break;
                                case SignOffBlockEditor signOff:
                                    <div class="field">
                                        <label for="valediction-@index">Valediction</label>
                                        <input id="valediction-@index" @bind="signOff.Valediction" @bind:event="oninput" />
                                        <span class="field-help">Such as "With love,".</span>
                                    </div>
                                    <div class="field">
                                        <label for="from-@index">From</label>
                                        <input id="from-@index" @bind="signOff.From" @bind:event="oninput" />
                                    </div>
                                    <div class="field">
                                        <label for="tagline-@index">Tagline (optional)</label>
                                        <input id="tagline-@index" @bind="signOff.Tagline" @bind:event="oninput" />
                                    </div>
                                    break;
                                case HeaderBlockEditor header:
                                    <div class="field">
                                        <label for="text-@index">Business name</label>
                                        <input id="text-@index" @bind="header.Text" @bind:event="oninput" />
                                    </div>
                                    <PhotoFields Block="header" Index="index" Photos="_photos" Optional="true" Changed="StateHasChanged" />
                                    break;
                                case ImageBlockEditor image:
                                    <PhotoFields Block="image" Index="index" Photos="_photos" Optional="!block.Required" Changed="StateHasChanged" />
                                    @if (!block.Required)
                                    {
                                        <span class="field-help">Leave the photo empty to send the email without it.</span>
                                    }
                                    break;
                                case OfferBlockEditor offerBlock:
                                    <OfferFields Offer="offerBlock.Offer" Index="index" Known="Known" SaveKnown="SaveKnownAsync" Changed="StateHasChanged" />
                                    break;
                            }
                            @if (block.Error is { } error)
                            {
                                <p class="field-help" role="alert">@error</p>
                            }
                        }
                    </section>
                }
            }
        </div>

        <aside class="workspace-side">
            <section class="card">
                <h2>Save</h2>
                <p class="field-help">A campaign can be saved unfinished. Each save is a new version.</p>
                <Problems Messages="errors" />
                <button class="button primary" disabled="@(errors.Count > 0)" @onclick="SaveAsync">Save campaign</button>
                @if (_message is not null)
                {
                    <p role="status">@_message</p>
                }
                @if (_session.Latest is { } latest)
                {
                    <p class="muted" data-testid="last-saved">Last saved @Times.DateAndTime(latest.SavedAt).</p>
                    @* With no version before it, undoing the save deletes the campaign: the button and
                       the question say so, rather than promising a version that is not there. *@
                    var deletes = _session.UndoDeletesTheCampaign;
                    @if (_confirmingUndo)
                    {
                        <p>@_session.UndoQuestion</p>
                        <button class="button danger" @onclick="UndoAsync">@(deletes ? "Delete it" : "Undo it")</button>
                        <button class="button" @onclick="() => _confirmingUndo = false">Keep it</button>
                    }
                    else
                    {
                        <button class="button" @onclick="() => _confirmingUndo = true">@(deletes ? "Delete campaign" : "Undo last save")</button>
                    }
                }
                @if (_session.Restorable is not null)
                {
                    <p class="field-help">The last undo can be taken back until @Times.DateAndTime(_session.RestorableUntil!.Value).</p>
                    <button class="button" @onclick="RestoreAsync">Restore undone save</button>
                }
            </section>

            @if (status.Missing.Count > 0)
            {
                <section class="card">
                    <h2>Still to do</h2>
                    <p class="field-help">Every part the template needs, filled in, and every copied line looked at. Each one stops the email going out.</p>
                    <ul class="findings">
                        @foreach (var item in status.Missing)
                        {
                            <li class="finding blocker">
                                <strong>Must fix</strong>
                                <span>@item.Message</span>
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="card">
                <h2>What the checks say</h2>
                @if (status.Missing.Count > 0)
                {
                    <p class="field-help">Checked so far: the parts filled in. The rest is checked as it is filled in.</p>
                }
                @if (status.Findings.Count == 0)
                {
                    <p>The rules find nothing to fix@(status.Missing.Count > 0 ? " so far" : "").</p>
                }
                <ul class="findings">
                    @foreach (var finding in status.Findings.OrderByDescending(f => f.Severity))
                    {
                        <FindingItem Finding="finding" />
                    }
                </ul>
                <p class="muted">These are the instant rules. The AI proofread is not switched on yet.</p>
            </section>

            <section class="card">
                <h2>Preview</h2>
                <p class="field-help">The email's blocks as Square will show them@(status.Missing.Count > 0 ? "; each part still to fill in is marked ‹like this›" : "").</p>
                <EmailPreview Blocks="status.Preview" Library="_photos" />
            </section>

            <section class="card">
                <h2>Approve</h2>
                @if (!_canReview)
                {
                    <p class="muted">Approving and exporting take the review permission, which you do not have.</p>
                }
                else if (approval is not null)
                {
                    <p class="approved" role="status">Approved by @approval.By, @Times.DateAndTime(approval.At).</p>
                    <p class="field-help">The approval is of this saved version. Any change, or a new save, needs approving again.</p>
                    <button class="button" @onclick="WithdrawAsync">Withdraw approval</button>
                }
                else
                {
                    @if (_session.Latest?.Approval is { } lapsed)
                    {
                        <p role="status">Approved by @lapsed.By, but changed since, so it is no longer approved.</p>
                    }
                    else if (_session.SupersededApproval?.Approval is { } earlier)
                    {
                        <p role="status">An earlier version was approved by @earlier.By. It has been saved since, so this version is not approved.</p>
                    }
                    @if (cannotApprove is not null)
                    {
                        <p class="field-help">@cannotApprove</p>
                    }
                    else
                    {
                        <p class="field-help">Nothing is left to fix. A person approves the campaign before it can be copied into Square.</p>
                        <div class="field">
                            <label for="approver">Your name</label>
                            <input id="approver" @bind="_approver" @bind:event="oninput" />
                        </div>
                        <button class="button primary" disabled="@string.IsNullOrWhiteSpace(_approver)" @onclick="ApproveAsync">Approve</button>
                    }
                }
            </section>

            @if (export is not null)
            {
                <section class="card">
                    <h2>Copy into Square</h2>
                    <p><span class="not-proofread">Not proofread by AI yet</span></p>
                    <p class="field-help">Approved, and the rules find nothing to stop it. The AI proofread isn't switched on yet, so read each block as you paste it. Paste them into Square's editor in this order.</p>
                    @if (assistant?.Json is { } json)
                    {
                        <div class="copy-actions">
                            <a class="button" href="@DataUrl(json)" download="@assistant.FileName">Download for an assistant (JSON)</a>
                        </div>
                        <p class="field-help">The same blocks, for an assistant to fill in Square's editor and check against. It stops at Square's preview; a person sends.</p>
                    }
                    else if (assistant?.Refusal is { } refusal)
                    {
                        <p class="field-help" role="alert">No download for an assistant: @refusal</p>
                    }
                    <ol class="export-blocks">
                        @for (var i = 0; i < export.Count; i++)
                        {
                            var block = export[i];
                            var id = $"export-{i}";
                            <li class="export-block">
                                <div class="block-card-head">
                                    <strong>@(i + 1). @KindName(block.Kind)</strong>
                                    <span class="not-proofread">Not proofread by AI yet</span>
                                </div>
                                @switch (block.Kind)
                                {
                                    case BlockKind.Spacer:
                                        <p class="field-help">A spacer: nothing to copy.</p>
                                        break;
                                    case BlockKind.Image:
                                        <p>Photo: @block.Image?.Name</p>
                                        @if (block.Text.Length > 0)
                                        {
                                            <pre id="@id">@block.Text</pre>
                                            <button type="button" class="button" data-copy="@id">Copy description</button>
                                            <CopyHint For="@id" />
                                        }
                                        break;
                                    case BlockKind.Button:
                                        <pre id="@id">@block.Text</pre>
                                        @if (block.Url is not null)
                                        {
                                            <pre id="@($"{id}-link")">@block.Url</pre>
                                        }
                                        <div class="copy-actions">
                                            <button type="button" class="button" data-copy="@id">Copy button text</button>
                                            @if (block.Url is not null)
                                            {
                                                <button type="button" class="button" data-copy="@($"{id}-link")">Copy link</button>
                                            }
                                        </div>
                                        <CopyHint For="@id" />
                                        @if (block.Url is not null)
                                        {
                                            <CopyHint For="@($"{id}-link")" />
                                        }
                                        break;
                                    default:
                                        <pre id="@id">@block.Text</pre>
                                        @if (block.Kind == BlockKind.Header && block.Image is not null)
                                        {
                                            <p class="field-help">Over the photo @block.Image.Name.</p>
                                        }
                                        <button type="button" class="button" data-copy="@id">Copy</button>
                                        <CopyHint For="@id" />
                                        break;
                                }
                            </li>
                        }
                    </ol>
                </section>
            }
            else if (warningsFirst.Count > 0)
            {
                @* Shown at export, once per version: the owner's "pop up a list of warnings when
                   exporting", as handholding, not handcuffs. Each finding links to its field; one
                   button goes on. Nothing here can be exported until she goes on. *@
                <section class="card export-warnings" role="dialog" aria-labelledby="export-warnings-title">
                    <h2 id="export-warnings-title">Before you copy it into Square</h2>
                    <p>@DraftSession.WarningsLead(warningsFirst.Count, ExportedBefore)</p>
                    <ul class="findings">
                        @foreach (var warning in warningsFirst)
                        {
                            <FindingItem Finding="warning" JumpTo="@JumpTo(warning)" />
                        }
                    </ul>
                    <p class="field-help">Fixing one changes the campaign: save it again and approve the new version.</p>
                    <button class="button primary" @onclick="ExportAnywayAsync">Export anyway</button>
                    <p class="field-help">You won't be asked again about these for this campaign, in this version or a later one, while they read the same; only something new would come up. The export notes that you saw them and went on.</p>
                </section>
            }
            else
            {
                <section class="card">
                    <h2>Export</h2>
                    @if (Site.IsDemo)
                    {
                        <p class="muted">On this demo, export comes once the campaign is approved with nothing left to fix. The AI proofread isn't switched on yet, so its blocks will be marked as not proofread.</p>
                    }
                    else
                    {
                        <p class="muted">Export comes once the AI proofread is switched on. A campaign leaves only after both the rules and the proofread have passed it.</p>
                    }
                </section>
            }
        </aside>
    </div>
}
else
{
    @* Until the reads are done: first as the page streams in, then again as it turns interactive.
       Never blank, and never the list it was opened from. *@
    <h1>@(Id is null ? "Starting a campaign" : "Opening the campaign")</h1>
    <p class="muted" role="status">One moment.</p>
}

@code {
    /// <summary>The template a new campaign starts from, for /campaigns/new/{templateId}.</summary>
    [Parameter]
    public Guid? TemplateId { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    private string? _denied;
    private string? _missing;
    // The client's registration could not be read: said instead of an editor whose checks would be wrong.
    private string? _unreadable;
    private CampaignStore? _store;
    private DraftSession? _session;
    // A campaign whose every save is undone, while it can still be restored.
    private SaveRef? _undone;
    private CampaignPolicy _policy = CampaignPolicy.Default;
    // The client's registration, for the phone numbers the checks hold the campaign to, with her
    // known items, which the pickers offer and the checks compare treatment names and benefits with.
    private BusinessContext? _business;
    private ClientName? _client;

    private KnownItems Known => _business?.Known ?? KnownItems.None;

    // What the checks are given: the registration and known items, with the names in her image
    // library, so a photo the library does not hold keeps only the note its field gives it, and the
    // tier-name ladders in force for her. Named by the client's name when it has no registration, as
    // for known items (ClientWorkspace.BusinessAsync).
    private BusinessContext Business =>
        (_business ?? new BusinessContext(_client!.ToString())) with
        {
            LibraryPhotos = _photos.Select(p => p.Name).ToList(),
            Ladders = _ladders,
        };
    private TierLadders _ladders = TierLadders.Standard;

    // "Save as a known item" next to a tier or a benefit: kept exactly as written, then the pickers
    // and the checks read the list again. Neither may throw: on this interactive page an exception
    // ends the connection, and her unsaved campaign with it. A store failure comes back as a message
    // (logged by the session); a failure to read the list again keeps the list she had, logged here.
    private async Task<string> SaveKnownAsync(KnownItem item)
    {
        var message = await KnownItemsSession.SaveFromCampaignAsync(
            Workspace.Known, Recorder.For(_client!, await Workspace.ActorAsync()), item, Log);
        try
        {
            _business = await Workspace.BusinessAsync(_client!);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Could not read the registration of {Client} again after saving a known item.", _client!.Value);
        }
        return message;
    }
    private IReadOnlyList<LibraryImage> _photos = [];
    private string? _message;
    private bool _confirmingUndo;
    // In the client's own zone, once it is known.
    private LocalTime? _times;
    private LocalTime Times => _times ?? Workspace.DefaultTimes;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Approving and exporting are the Review feature, on top of the page's Campaigns.
    private bool _canReview;
    private string _approver = "";

    private string Title => _session is null ? "Campaign" : _session.Editor.Title;

    protected override async Task OnInitializedAsync()
    {
        var (client, reason) = await Workspace.ClientDataAsync();
        if (client is null)
        {
            _denied = reason;
            return;
        }
        _client = client;
        // Before the campaign, which streams in showing its times.
        _times = await Workspace.TimesAsync(client);
        if (AuthenticationState is not null)
            _canReview = (await Authorization.AuthorizeAsync((await AuthenticationState).User, Features.Review)).Succeeded;

        var actor = await Workspace.ActorAsync();
        var store = _store = Stores.Campaigns(client, actor);
        if (Id is { } id)
        {
            _session = await DraftSession.OpenAsync(store, id);
            if (_session is null) _undone = await DraftSession.RestorableAsync(store, id);
            if (_session is null && _undone is null) _missing = "Campaign not found";
        }
        else if (TemplateId is { } templateId)
        {
            _session = await DraftSession.StartAsync(store, templateId);
            if (_session is null) _missing = "Template not found";
        }
        _policy = await Stores.PolicyInForceAsync(client);
        _ladders = (await Stores.LaddersInForceAsync(client)).Ladders;
        try
        {
            _business = await Workspace.BusinessAsync(client);
        }
        catch (RegistrationUnreadableException ex)
        {
            // Logged by the workspace. Without the registration the checks would pass numbers they
            // should flag, so the campaign is not shown as checked.
            _unreadable = ex.Message;
            return;
        }
        _photos = await Stores.Images(client, actor).ListAsync();
    }

    private async Task SaveAsync()
    {
        var isNew = _session!.Id is null;
        var before = _session.Latest;
        var saved = await _session.SaveAsync();
        _message = DraftSession.SavedMessage(before, saved, Times);
        _confirmingUndo = false;
        // The address now names the campaign, so a reload opens what was saved. Only the address
        // changes: navigating would load the page afresh, at the top and without the saved line.
        if (isNew) await ShowAddressAsync(Navigation.ToAbsoluteUri($"campaigns/{saved.Id}").AbsoluteUri);
        await ShowTitleAsync(Title);
    }

    // The browser's address, replaced in place. A failure is only logged: the save stands, and the
    // campaign is in her list whatever the address bar says.
    private async Task ShowAddressAsync(string address)
    {
        try
        {
            await JS.InvokeVoidAsync("history.replaceState", null, "", address);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Log.LogWarning(ex, "Could not show the saved campaign's address.");
        }
    }

    // The tab's title, as a reload would show it. PageTitle sets it only as the page is first sent
    // (the head is not interactive), so after a save it is set here: the first save's tab otherwise
    // says "Untitled campaign" until a reload. A failure is only logged, as for the address.
    private async Task ShowTitleAsync(string title)
    {
        try
        {
            await JS.SetValueAsync("document.title", title);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Log.LogWarning(ex, "Could not show the saved campaign's title.");
        }
    }

    // Undo marks the save for deletion; nothing is deleted here, or by leaving the page.
    private async Task UndoAsync()
    {
        _confirmingUndo = false;
        if (await _session!.UndoLastSaveAsync())
        {
            _message = "The last save was undone; the version before it is open.";
            return;
        }
        // Nothing left in use: the campaign is gone from the list, and can still be restored.
        _undone = _session.Restorable;
        _session = null;
        _message = null;
        if (_undone is null) _missing = "Campaign not found";
    }

    private async Task RestoreAsync()
    {
        _confirmingUndo = false;
        _message = await _session!.RestoreAsync()
            ? "The undone save is back and open."
            : "That save can no longer be restored.";
    }

    private async Task RestoreUndoneAsync()
    {
        _session = await DraftSession.RestoreAsync(_store!, _undone!);
        _undone = null;
        if (_session is null) _missing = "Campaign not found";
        else _message = "The undone save is back and open.";
    }

    private async Task ApproveAsync()
    {
        if (!_canReview) return;
        try
        {
            var approval = await _session!.ApproveAsync(_approver, _policy, Business);
            _message = $"Approved by {approval.By}.";
            _approver = "";
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _message = ex.Message;
        }
    }

    private async Task WithdrawAsync()
    {
        if (!_canReview) return;
        try
        {
            await _session!.WithdrawApprovalAsync();
            _message = "The approval is withdrawn.";
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }

    // The demo's export, and only the demo's: an approved campaign, unchanged since, that the rules
    // pass, reviewed without the proofread and marked so (DraftSession.DemoExportReport). Null
    // everywhere else, Enforced included, where export waits for the proofread.
    private ReviewReport? ExportReport() =>
        Site.IsDemo && _canReview ? _session!.DemoExportReport(_policy, Business) : null;

    // The same gate's findings to show before that export, on the demo only, as the export is: those
    // nobody has been shown for this campaign yet, on this version or an earlier one. Checked with
    // the same business as the export (Business, with her library and ladders), so the list is
    // exactly what the export waits for.
    private IReadOnlyList<Finding> WarningsBeforeExport() =>
        Site.IsDemo && _canReview ? _session!.WarningsBeforeExport(_policy, Business) : [];

    // Whether someone went on past this campaign's warnings before, on this version or an earlier
    // one, with their keys kept: then the list holds only what is new since.
    private bool ExportedBefore => _session?.CurrentApproval?.WarningsSeen?.Keys is not null;

    // "Export anyway": recorded with this version's approval, who and when and the warnings' keys
    // (hashes, never their text), and then the export is there. A failure says why; the campaign is
    // untouched either way.
    private async Task ExportAnywayAsync()
    {
        if (!Site.IsDemo || !_canReview) return;
        try
        {
            await _session!.WarningsSeenAtExportAsync(_policy, Business);
            _message = null;
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }

    // Where a finding's field is on this page: the subject line, or the block it is in. The address
    // is this campaign's own, so the link only moves down the page. Null for the whole email.
    private string? JumpTo(Finding finding)
    {
        var editor = _session!.Editor;
        var anchor = finding.Location == FindingPlace.Subject
            ? "subject"
            : FindingPlace.BlockIndex(finding.Location, editor.Blocks.Select(b => b.Label).ToList()) is { } i
                ? $"block-{i}"
                : null;
        return anchor is null ? null : $"campaigns/{_session.Id}#{anchor}";
    }

    // The JSON as a link to download, with no endpoint: an endpoint would be a second way out.
    private static string DataUrl(string json) =>
        "data:application/json;charset=utf-8;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));

    // Square's name for each kind, from the same table the assistant export writes its types from.
    private static string KindName(BlockKind kind) =>
        SquareWidgets.ByKind.TryGetValue(kind, out var widget) ? widget.DisplayName : kind.ToString();

}
