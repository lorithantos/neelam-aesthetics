@page "/campaigns/new/{TemplateId:guid}"
@page "/campaigns/{Id:guid}"
@* Writing a campaign: the access check decides whose, on top of the policy. The page only binds to
   CampaignEditor (through DraftSession); the checks shown are the rules alone, run over what is
   filled in even while parts are missing. A saved campaign with nothing left to fix can be
   approved, by name; the approval is of that save, so any edit or later save undoes it. Approving
   and exporting take the Review feature on top of Campaigns. Export needs the AI proofread, as
   EditorExport.Blocks requires, so it stays locked, except on the demo (SiteMode, which is
   Prototype access): there an approved campaign the rules pass exports through
   CampaignGate.DemoReview, every block marked as not proofread, and the same report gives the
   assistant's JSON (AssistantExport) beside the copy blocks. The offer and photo fields are
   child components, which tell the page of each change so the checks follow what is typed. The
   label at the top is the client's own name for the campaign, saved with the draft and never part
   of the email, its checks or its export. Another tab or person may change the campaign while this
   page is open (owner, 2026-10-11): PageWatch tells the page, at once on this instance and within
   CampaignWatch:Interval from anywhere, and the page says so with "Load the latest", keeping her
   unsaved edits until she chooses. Approve reads storage and the checks' lists again at the click,
   the export is shown only from a read of storage that agrees with the page, and Undo takes back
   only the version on the page while it is still the newest. *@
@attribute [Authorize(Policy = Features.Campaigns)]
@* Streamed, so the page says it is opening the campaign as soon as it is clicked: without it, the
   list stays on screen under the campaign's address until every read is done, which reads as the
   click landing back on the list. *@
@attribute [StreamRendering]
@rendermode InteractiveServer
@inherits WatchedComponent<SaveRef>
@inject ClientWorkspace Workspace
@inject ClientStores Stores
@inject NavigationManager Navigation
@inject SiteMode Site
@inject BlockCatalog Blocks
@inject IAuthorizationService Authorization
@inject ActivityRecorder Recorder
@inject ILogger<CampaignEdit> Log
@inject IJSRuntime JS
@inject ProofreadSwitch Proofreading
@inject IProofreader Proofreader
@inject DailyProofreadAllowance Allowance

<PageTitle>@Title</PageTitle>

@if (_denied is not null)
{
    <h1>Campaigns</h1>
    <p>You cannot write campaigns here: @_denied.</p>
}
else if (_unreadable is not null)
{
    <h1>This campaign can't be checked yet</h1>
    <p>@_unreadable <a href="campaigns">Back to campaigns</a></p>
}
else if (_missing is not null)
{
    <h1>@(Id is null ? "This template couldn't be opened" : "This campaign couldn't be opened")</h1>
    <p>@_missing: there is nothing saved here. It may have been deleted. <a href="campaigns">Back to campaigns</a></p>
}
else if (_undone is not null)
{
    <h1>@_undone.Title</h1>
    <p data-testid="deleted-note">This campaign is deleted. You can restore it until
        @Times.DateAndTime(_store!.RestorableUntil(_undone)!.Value); after that it is removed for good.
        Until then it is also under Recently deleted in your campaigns.</p>
    <button class="button primary" data-testid="restore-deleted" @onclick="RestoreUndoneAsync">Restore</button>
    <a class="button" href="campaigns">Back to campaigns</a>
    @if (_message is not null)
    {
        <p role="status" data-testid="page-message">@_message</p>
    }
}
else if (_session is not null)
{
    var editor = _session.Editor;
    var errors = editor.Errors();
    var status = editor.Status(_policy, Business);
    var approval = _session.CurrentApproval;
    var cannotApprove = _session.CannotApprove(_policy, Business);
    // The AI proofread of this saved version, while the form still holds it: the export takes its
    // findings as it takes the rules'.
    var proofread = _session.CurrentProofread;
    IReadOnlyList<Finding> proofreadFindings = proofread?.Findings ?? [];
    // The LLM report shown (owner, 2026-10-31): this version's, or an earlier one's carried forward,
    // each finding greyed once its quote has left the form. Listed with the rules'.
    var report = _session.Report;
    // One gate for both forms of the export: the copy blocks and the assistant's JSON come from
    // the same report, so neither exists without the other, and both carry the approval that
    // report was made with (DraftSession.DemoExportReport: the approval in force, never the
    // latest save's, which an unsaved edit leaves in place).
    var exportReport = ExportReport();
    // Before the export, every "Worth a look" finding she has not been shown at export for this
    // version: listed with a way to each field, and one button to go on. Never a fix required.
    var warningsFirst = WarningsBeforeExport();
    // What storage says changed since this page's version, by its last read: anything, and the page
    // says so, and neither the export nor its list of warnings is offered from it.
    var change = StorageChange;
    // The export only from a read of storage since it was last not offered, that agrees with the page:
    // never from what the page holds alone (ExportConfirmed).
    var exportStale = change != CampaignChange.None && (exportReport is not null || warningsFirst.Count > 0);
    var export = exportReport is null || !ExportConfirmed(change) ? null : EditorExport.Blocks(exportReport);
    // Checked by the LLM: then nothing is marked "Not checked by the LLM yet", and the JSON says proofread.
    var exportProofread = exportReport?.Proofread == true;
    var assistant = exportReport is null ? null : AssistantExport.Offer(exportReport, exportReport.DemoApproval,
        new AssistantExportContext(_session.Id, editor.Label, _session.TemplateNameNow(_templates), name => ImageLibrary.Find(_photos, name)?.SquareUrl));

    <KnownItemLists Known="Known" />
    <h1>@Title</h1>
    <p><a href="campaigns">Back to campaigns</a></p>

    @* The template the campaign follows (owner, 2026-10-31): Update to template when the one it was
       made from has changed, and any of hers can be picked and used at any time. Using one changes the
       form only; she saves as usual. When something she wrote would be lost, she is asked first. *@
    var standing = _session.TemplateStatus(_templates);
    var picked = PickedTemplate;
    var attached = editor.Draft.TemplateId?.ToString();
    <div class="field">
        <label for="template">Template</label>
        <select id="template" data-testid="template-picker" @bind:get="picked" @bind:set="PickTemplate">
            <option value="">Choose a template</option>
            @foreach (var t in _templates)
            {
                <option value="@t.Id">@t.Title</option>
            }
        </select>
        @* The template by its id alone, its name as it is now (owner, 2026-11-01: "renaming a template
           should not change the campaigns. We should use an ID instead of the name"). *@
        @if (standing == TemplateStanding.Changed)
        {
            <p class="field-help" data-testid="template-changed">The template @_session.TemplateNameNow(_templates) has changed since this campaign was made.</p>
        }
        else if (standing == TemplateStanding.Gone)
        {
            <p class="field-help" data-testid="template-gone">The template this campaign was made from no longer exists. This campaign still works as it is, and you can choose another template.</p>
        }
        <div class="block-actions">
            @if (picked.Length > 0 && picked != attached)
            {
                <button class="button" data-testid="template-use" disabled="@(errors.Count > 0)" @onclick="UseTemplateAsync">Use this template</button>
            }
            else if (standing == TemplateStanding.Changed && picked == attached)
            {
                <button class="button" data-testid="template-update" disabled="@(errors.Count > 0)" @onclick="UseTemplateAsync">Update to template</button>
            }
        </div>
        @if (_askTemplate is { } ask)
        {
            <section class="card" role="alert" data-testid="template-confirm">
                <p>Using the template @ask.Template.Name changes what you wrote here:</p>
                <ul>
                    @foreach (var label in ask.Update.Dropped)
                    {
                        <li data-testid="template-dropped">@label: the template has no place for it, so it goes.</li>
                    }
                    @foreach (var label in ask.Update.Replaced)
                    {
                        <li data-testid="template-replaced">@label: the template's own text takes the place of yours.</li>
                    }
                </ul>
                <button class="button danger" data-testid="template-confirm-use" disabled="@(errors.Count > 0)" @onclick="ConfirmTemplateAsync">Use the template</button>
                <button class="button" data-testid="template-keep" @onclick="() => _askTemplate = null">Keep it as it is</button>
            </section>
        }
        @if (_templateMessage is not null)
        {
            <p role="status" data-testid="template-message">@_templateMessage</p>
        }
    </div>

    @* The owner's "modified" (2026-10-11). Nothing on the page is replaced until she chooses: what she
       typed stays, and Load the latest says what it does to it. Keep mine (owner, 2026-10-11) where the
       page holds another version than the newest: hers, edited or not, saved again as the newest;
       nothing is deleted. Not for an approval changed elsewhere, where the content is the same and
       there is nothing to keep. *@
    var edited = _session.HasUnsavedChanges;
    <ModifiedNotice Words="ChangeWords.Campaign" Change="change" OnLoadLatest="LoadLatestAsync"
                    Unsaved="@(edited ? ModifiedNotice.ChangesNotSaved : null)"
                    KeepMine="KeepMineWhen.OnChange" OnKeepMine="KeepMineAsync" KeepMineDisabled="errors.Count > 0"
                    KeepMineLabel="@(edited ? "Keep mine" : "Use this version again")"
                    KeepMineHelp="@((edited
                        ? "Keep mine saves what's on this page as the newest version."
                        : "Use this version again saves this version as the newest.") + " The other version stays in the campaign's history.")" />

    <div class="workspace">
        <div class="workspace-main">
            <div class="field">
                <label for="label">Label (just for you)</label>
                <input id="label" @bind="editor.Label" @bind:event="oninput" />
                <span class="field-help">e.g. Beauty Bank -- first send. It names the campaign in your list, so two with the same subject can be told apart. It is never part of the email.</span>
            </div>

            <div class="field">
                <label for="subject">Subject line</label>
                <input id="subject" data-testid="subject" @bind="editor.Subject.Text" @bind:event="oninput" />
                <span class="field-help">What the reader sees in their inbox.</span>
            </div>

            <h2>The email, top to bottom</h2>
            @for (var i = 0; i < editor.Blocks.Count; i++)
            {
                var index = i;
                var block = editor.Blocks[index];
                if (block is not SpacerBlockEditor)
                {
                    <section class="card block-card" id="block-@index" aria-label="@block.Label">
                        <div class="block-card-head">
                            <h3>@block.Label</h3>
                            <span class="muted">@Blocks.For(block.Type).Label@(block.IsFixed ? " · the same in every campaign" : block.Required ? "" : " · optional")</span>
                        </div>

                        @if (block.IsFixed)
                        {
                            <p class="field-help">Written once, in the template. It goes out like this:</p>
                            <EmailPreview Blocks="block.FixedPreview" Library="_photos" />
                        }
                        else
                        {
                            @switch (block)
                            {
                                case TextBlockEditor text when block.Type == BlockType.FinePrint:
                                    <div class="field">
                                        <label for="text-@index">Fine print</label>
                                        <textarea id="text-@index" @bind="text.Field.Text" @bind:event="oninput"></textarea>
                                    </div>
                                    break;
                                case TextBlockEditor text:
                                    <div class="field">
                                        <label for="text-@index">@Blocks.For(block.Type).Label</label>
                                        <input id="text-@index" @bind="text.Field.Text" @bind:event="oninput" />
                                    </div>
                                    break;
                                case ParagraphsBlockEditor paragraphs:
                                    <div class="field">
                                        <label for="paragraphs-@index">Paragraphs</label>
                                        <textarea id="paragraphs-@index" @bind="paragraphs.Text" @bind:event="oninput"></textarea>
                                        <span class="field-help">Leave a blank line between paragraphs.</span>
                                    </div>
                                    break;
                                case ButtonBlockEditor button:
                                    <div class="field">
                                        <label for="button-label-@index">Button text</label>
                                        <input id="button-label-@index" @bind="button.ButtonLabel" @bind:event="oninput" />
                                    </div>
                                    <div class="field">
                                        <label for="button-url-@index">Link</label>
                                        <input id="button-url-@index" type="url" @bind="button.ButtonUrl" @bind:event="oninput" />
                                        <span class="field-help">The full address, starting https://.</span>
                                    </div>
                                    break;
                                case SignOffBlockEditor signOff:
                                    <div class="field">
                                        <label for="valediction-@index">Valediction</label>
                                        <input id="valediction-@index" @bind="signOff.Valediction" @bind:event="oninput" />
                                        <span class="field-help">Such as "With love,".</span>
                                    </div>
                                    <div class="field">
                                        <label for="from-@index">From</label>
                                        <input id="from-@index" @bind="signOff.From" @bind:event="oninput" />
                                    </div>
                                    <div class="field">
                                        <label for="tagline-@index">Tagline (optional)</label>
                                        <input id="tagline-@index" @bind="signOff.Tagline" @bind:event="oninput" />
                                    </div>
                                    break;
                                case HeaderBlockEditor header:
                                    <div class="field">
                                        <label for="text-@index">Business name</label>
                                        <input id="text-@index" @bind="header.Text" @bind:event="oninput" />
                                    </div>
                                    <PhotoFields Block="header" Index="index" Photos="_photos" Optional="true" Changed="StateHasChanged" />
                                    break;
                                case ImageBlockEditor image:
                                    <PhotoFields Block="image" Index="index" Photos="_photos" Optional="!block.Required" Changed="StateHasChanged" />
                                    @if (!block.Required)
                                    {
                                        <span class="field-help">Leave the photo empty to send the email without it.</span>
                                    }
                                    break;
                                case OfferBlockEditor offerBlock:
                                    <OfferFields Offer="offerBlock.Offer" Index="index" Known="Known" SaveKnown="SaveKnownAsync" Changed="StateHasChanged" />
                                    break;
                                case PromotionBlockEditor promotionBlock:
                                    <PromotionFields Promotion="promotionBlock.Promotion" Index="index" Known="Known" Changed="StateHasChanged" />                                    break;
                            }
                            @if (block.Error is { } error)
                            {
                                <p class="field-help" role="alert">@error</p>
                            }
                        }
                    </section>
                }
            }
        </div>

        <aside class="workspace-side">
            <section class="card" data-testid="save-card">
                <h2>Save</h2>
                <p class="field-help">A campaign can be saved unfinished. Each save is a new version.</p>
                <Problems Messages="errors" />
                <button class="button primary" disabled="@(errors.Count > 0)" data-testid="save-button" @onclick="SaveAsync">Save campaign</button>
                @if (_message is not null)
                {
                    <p role="status" data-testid="page-message">@_message</p>
                }
                @if (_session.Latest is { } latest)
                {
                    <p class="muted" data-testid="last-saved">Last saved @Times.DateAndTime(latest.SavedAt).</p>
                }
                @* Undo last save only while there is a version before the newest to go back to: with
                   none, undoing it would be the same as deleting, which Delete campaign below offers. *@
                <UndoRestore CanUndo="_session.Latest is not null" Confirming="_confirmingUndo" ConfirmingChanged="ConfirmUndo"
                             Question="@_session.UndoQuestion" UndoDeletes="_session.UndoDeletesTheCampaign" OnUndo="UndoAsync"
                             RestorableUntil="_session.RestorableUntil" Times="Times" OnRestore="RestoreAsync" RestoreId="restore-button" />
                @* Delete takes the whole campaign, every version, restorable for the grace period
                   (Priya, 2026-10-31). In the Save card, last and set apart, in the destructive style and
                   saying so in words, not colour alone (owner, 2026-10-31: "let's make it very clear that
                   this is dangerous"). A campaign with an approved version is kept as a record (owner,
                   2026-10-31: "No, these are recorded"), and the page says so in its place. *@
                @if (_session.Latest is not null)
                {
                    @if (_session.CannotDelete is { } kept)
                    {
                        <p class="field-help delete-zone" data-testid="delete-refused">@kept</p>
                    }
                    else
                    {
                        <div class="delete-zone" role="group" aria-label="Delete campaign" data-testid="delete-zone">
                            @if (_confirmingDelete)
                            {
                                <p data-testid="delete-question">@_session.DeleteQuestion</p>
                                <button type="button" class="button danger" data-testid="delete-confirm" @onclick="DeleteAsync">Delete it</button>
                                <button type="button" class="button" data-testid="delete-keep" @onclick="() => _confirmingDelete = false">Keep it</button>
                            }
                            else
                            {
                                <p class="delete-warning"><strong>Danger:</strong> deleting takes the whole campaign, every version, off your list.</p>
                                <button type="button" class="button danger" data-testid="delete-button" @onclick="() => (_confirmingDelete, _confirmingUndo) = (true, false)">Delete campaign</button>
                            }
                        </div>
                    }
                }
            </section>

            @if (status.Missing.Count > 0)
            {
                <section class="card">
                    <h2>Still to do</h2>
                    <p class="field-help">Every part the template needs, filled in, and every copied line looked at. Each one stops the email going out.</p>
                    <ul class="findings">
                        @foreach (var item in status.Missing)
                        {
                            <li class="finding blocker">
                                <strong>Must fix</strong>
                                <span>@item.Message</span>
                            </li>
                        }
                    </ul>
                </section>
            }

            <section class="card">
                <h2>What the checks say</h2>
                @if (status.Missing.Count > 0)
                {
                    <p class="field-help">Checked so far: the parts filled in. The rest is checked as it is filled in.</p>
                }
                @* One summary of everything listed, the rules' and the AI proofread's alike (owner,
                   2026-10-10: "'The rules find nothing to fix.' this is confusing" beside the AI's
                   findings); each AI finding says so beside how much it matters. *@
                @* A rule's finding goes once fixed, as the checks re-run; an LLM finding stays in its
                   place, greyed, once its quote has left the form (owner, 2026-10-31), and only those
                   still to look at are counted. *@
                @* A finding about the day it is, not the email (a promotion that has ended since), is a
                   Must fix until the version is approved, then only information: time alone never stops
                   an approved version from exporting (owner, 2026-11-02). *@
                @{
                    var sinceApproved = status.Findings.Where(f => approval is not null && f.OnceApproved is not null).ToList();
                    var llmListed = report?.Findings ?? [];
                    var listed = status.Findings.Where(f => approval is null || f.OnceApproved is null).Select(f => (Finding: f, LooksFixed: false))
                        .Concat(llmListed.Select(f => (f.Finding, f.LooksFixed)))
                        .OrderByDescending(x => x.Finding.Severity).ToList();
                    var shownFindings = listed.Select(x => x.Finding).ToList();
                }
                <p data-testid="checks-summary">@DraftSession.ChecksSummary(listed.Where(x => !x.LooksFixed).Select(x => x.Finding), soFar: status.Missing.Count > 0)</p>
                <ul class="findings" data-testid="checks-findings">
                    @for (var i = 0; i < listed.Count; i++)
                    {
                        <FindingItem Finding="listed[i].Finding" LooksFixed="listed[i].LooksFixed" ExplainLlm="@(i == FirstLlm(shownFindings))"
                                     Fix="SuggestedFix.Check(editor, listed[i].Finding)" Use="UseFix" />
                    }
                </ul>
                @if (sinceApproved.Count > 0)
                {
                    <ul class="findings" data-testid="checks-since-approved">
                        @foreach (var note in sinceApproved)
                        {
                            <li class="finding">@note.OnceApproved</li>
                        }
                    </ul>
                }
                @if (_fixMessage is not null)
                {
                    <p role="status" data-testid="fix-message">@_fixMessage</p>
                }
                @if (!ProofreadOffered)
                {
                    <p class="muted" data-testid="checks-llm-off">These are the instant rules. Proofreading with the <Llm TestId="llm-term-checks" /> is not switched on yet.</p>
                }
                else if (report is null)
                {
                    <p class="muted" data-testid="checks-before-proofread">These are the instant rules. The <Llm TestId="llm-term-checks" /> reads a saved version when you ask it to, below.</p>
                }
            </section>

            @if (ProofreadOffered)
            {
                @* Proofreading with the LLM, on the demo, on her click only (owner, 2026-10-10): never per
                   keystroke or by itself. "Proofread" is the click; what it leaves is the version's LLM
                   report (owner, 2026-10-10: one word was doing two jobs). The report stays across
                   edits and saves (owner, 2026-10-31: "fixing ONE LLM issue clears the entire list"):
                   from an earlier version, it says how many are still to look at and how many look
                   fixed, and she proofreads once at the end. Approval and export still count only this
                   version's own proofread. A refusal or a failure is said plainly here and changes
                   nothing else: the rules stand on their own. *@
                <section class="card" aria-labelledby="proofread-title" data-testid="proofread">
                    <h2 id="proofread-title" data-testid="proofread-title"><Llm TestId="llm-term-report" /> report</h2>
                    @if (report is { IsCurrent: true })
                    {
                        <p data-testid="proofread-status">LLM report, @Times.DateAndTime(report.Record.At): @DraftSession.ProofreadSummary(report.Record) What you fix greys out here as you go; proofread again when you're done.</p>
                    }
                    else
                    {
                        @if (report is not null)
                        {
                            <p data-testid="proofread-carried">LLM report from an earlier version, @Times.DateAndTime(report.Record.At): @report.CarriedSummary()</p>
                        }
                        @if (_session.CannotProofread(_policy, Business) is { } notYet)
                        {
                            <p class="field-help" data-testid="proofread-status">@notYet</p>
                        }
                        else
                        {
                            <p class="field-help" data-testid="proofread-status">No LLM report for this version yet. The LLM reads it once, when you click, photos included, the way a careful editor would. Any change after needs a new save and a new proofread.</p>
                            <button class="button primary" data-testid="proofread-button" disabled="@_proofreading" @onclick="ProofreadAsync">@(_proofreading ? "Proofreading…" : "Proofread with the LLM")</button>
                        }
                    }
                    @if (_proofreadMessage is not null)
                    {
                        <p role="status" data-testid="proofread-message">@_proofreadMessage</p>
                    }
                    @if (report is { Photos.Count: > 0 })
                    {
                        <ul class="findings" data-testid="proofread-photos">
                            @foreach (var photo in report.Photos)
                            {
                                var photoClass = "finding" + (photo.Photo.Checked ? "" : " warning") + (photo.LooksFixed ? " looks-fixed" : "");
                                <li class="@photoClass"><strong>@(photo.LooksFixed ? $"{photo.Photo.Name} · Looks fixed" : photo.Photo.Name)</strong> <span>@photo.Photo.Note</span></li>
                            }
                        </ul>
                    }
                </section>
            }

            <section class="card">
                <h2>Preview</h2>
                <p class="field-help">The email's blocks as Square will show them@(status.Missing.Count > 0 ? "; each part still to fill in is marked ‹like this›" : "").</p>
                <EmailPreview Blocks="status.Preview" Library="_photos" />
            </section>

            <section class="card">
                <h2>Approve</h2>
                @if (!_canReview)
                {
                    <p class="muted">Approving and exporting take the review permission, which you do not have.</p>
                }
                else if (approval is not null)
                {
                    <p class="approved" role="status" data-testid="approved">Approved by @approval.Names, @Times.DateAndTime(approval.LastAt).</p>
                    <p class="field-help">The approval is of this saved version. Any change, or a new save, needs approving again.</p>
                    <button class="button" data-testid="withdraw-button" @onclick="WithdrawAsync">Withdraw approval</button>
                }
                else if (_session.CurrentPartApproval is { } soFar)
                {
                    @* A client needing more than one approver (owner, 2026-11-03): not approved until enough
                       different people have, so the export stays shut and the next person can approve. *@
                    <p role="status" data-testid="approval-progress">@DraftSession.PartApprovalWords(soFar, _session.ApprovalsRequired)</p>
                    <p class="field-help" data-testid="approval-still-needed">@DraftSession.StillNeededWords(soFar, _session.ApprovalsRequired)</p>
                    @if (cannotApprove is not null)
                    {
                        <p class="field-help">@cannotApprove</p>
                    }
                    else
                    {
                        <div class="field">
                            <label for="approver">Your name</label>
                            <input id="approver" data-testid="approver" @bind="_approver" @bind:event="oninput" />
                        </div>
                        <button class="button primary" data-testid="approve-button" disabled="@string.IsNullOrWhiteSpace(_approver)" @onclick="ApproveAsync">Approve</button>
                    }
                    <button class="button" data-testid="withdraw-button" @onclick="WithdrawAsync">Withdraw approval</button>
                }
                else
                {
                    @if (_session.Latest?.Approval is { } lapsed)
                    {
                        <p role="status">Approved by @lapsed.By, but changed since, so it is no longer approved.</p>
                    }
                    else if (_session.SupersededApproval?.Approval is { } earlier)
                    {
                        <p role="status">An earlier version was approved by @earlier.By. It has been saved since, so this version is not approved.</p>
                    }
                    @if (cannotApprove is not null)
                    {
                        <p class="field-help">@cannotApprove</p>
                    }
                    else
                    {
                        <p class="field-help">Nothing is left to fix. A person approves the campaign before it can be copied into Square.</p>
                        <div class="field">
                            <label for="approver">Your name</label>
                            <input id="approver" data-testid="approver" @bind="_approver" @bind:event="oninput" />
                        </div>
                        <button class="button primary" data-testid="approve-button" disabled="@string.IsNullOrWhiteSpace(_approver)" @onclick="ApproveAsync">Approve</button>
                    }
                }
            </section>

            @if (exportStale)
            {
                @* Storage no longer agrees with this page: nothing is offered to copy, and it says why. *@
                <section class="card">
                    <h2>Copy into Square</h2>
                    <p role="alert" data-testid="export-refused">@ChangeWords.Campaign.NotExported(change)</p>
                </section>
            }
            else if (exportReport is not null && export is null)
            {
                @* Offered again after it was not: read from storage first, a moment. *@
                <section class="card">
                    <h2>Copy into Square</h2>
                    <p class="muted" role="status" data-testid="export-checking">Checking this is still the latest approved version.</p>
                </section>
            }
            else if (export is not null)
            {
                <section class="card" data-testid="export">
                    <h2>Copy into Square</h2>
                    @if (exportProofread)
                    {
                        <p class="field-help" data-testid="export-proofread">Approved and checked by the <Llm TestId="llm-term-export" />, and nothing found stops it. Paste the blocks into Square's editor in this order.</p>
                    }
                    else
                    {
                        @* The export's own words (AssistantExport.DemoNotice), with "LLM" explained once here
                           rather than on every block below. *@
                        <p><span class="not-proofread" data-testid="export-not-checked">Not checked by the <Llm TestId="llm-term-export" /> yet</span></p>
                        <p class="field-help" data-testid="export-not-checked-why">Approved, and the rules find nothing to stop it. @(ProofreadOffered ? "No LLM report for this version yet" : "Proofreading with the LLM isn't switched on yet"), so read each block as you paste it. Paste them into Square's editor in this order.</p>
                    }
                    @if (assistant?.Json is { } json)
                    {
                        <div class="copy-actions">
                            <a class="button" href="@DataUrl(json)" download="@assistant.FileName" data-testid="assistant-download">Download for an assistant (JSON)</a>
                        </div>
                        <p class="field-help">The same blocks, for an assistant to fill in Square's editor and check against. It stops at Square's preview; a person sends.</p>
                    }
                    else if (assistant?.Refusal is { } refusal)
                    {
                        <p class="field-help" role="alert">No download for an assistant: @refusal</p>
                    }
                    <ol class="export-blocks">
                        @for (var i = 0; i < export.Count; i++)
                        {
                            var block = export[i];
                            var id = $"export-{i}";
                            <li class="export-block">
                                <div class="block-card-head">
                                    <strong>@(i + 1). @KindName(block.Kind)</strong>
                                    @if (!exportProofread)
                                    {
                                        <span class="not-proofread" data-testid="export-not-checked-@i">@AssistantExport.DemoNotice</span>
                                    }
                                </div>
                                @switch (block.Kind)
                                {
                                    case BlockKind.Spacer:
                                        <p class="field-help">A spacer: nothing to copy.</p>
                                        break;
                                    case BlockKind.Image:
                                        <p>Photo: @block.Image?.Name</p>
                                        @if (block.Text.Length > 0)
                                        {
                                            <pre id="@id">@block.Text</pre>
                                            <button type="button" class="button" data-copy="@id">Copy description</button>
                                            <CopyHint For="@id" />
                                        }
                                        break;
                                    case BlockKind.Button:
                                        <pre id="@id">@block.Text</pre>
                                        @if (block.Url is not null)
                                        {
                                            <pre id="@($"{id}-link")">@block.Url</pre>
                                        }
                                        <div class="copy-actions">
                                            <button type="button" class="button" data-copy="@id">Copy button text</button>
                                            @if (block.Url is not null)
                                            {
                                                <button type="button" class="button" data-copy="@($"{id}-link")">Copy link</button>
                                            }
                                        </div>
                                        <CopyHint For="@id" />
                                        @if (block.Url is not null)
                                        {
                                            <CopyHint For="@($"{id}-link")" />
                                        }
                                        break;
                                    default:
                                        <pre id="@id">@block.Text</pre>
                                        @if (block.Kind == BlockKind.Header && block.Image is not null)
                                        {
                                            <p class="field-help">Over the photo @block.Image.Name.</p>
                                        }
                                        <button type="button" class="button" data-copy="@id">Copy</button>
                                        <CopyHint For="@id" />
                                        break;
                                }
                            </li>
                        }
                    </ol>
                </section>
            }
            else if (warningsFirst.Count > 0)
            {
                @* Shown at export, once per version: the owner's "pop up a list of warnings when
                   exporting", as handholding, not handcuffs. Each finding links to its field; one
                   button goes on. Nothing here can be exported until she goes on. *@
                <section class="card export-warnings" role="dialog" aria-labelledby="export-warnings-title">
                    <h2 id="export-warnings-title">Before you copy it into Square</h2>
                    <p>@DraftSession.WarningsLead(warningsFirst.Count, ExportedBefore)</p>
                    <ul class="findings" data-testid="export-warnings-list">
                        @for (var i = 0; i < warningsFirst.Count; i++)
                        {
                            var warning = warningsFirst[i];
                            <FindingItem Finding="warning" JumpTo="@JumpTo(warning)" Named="export-warning" ExplainLlm="@(i == FirstLlm(warningsFirst))" />
                        }
                    </ul>
                    <p class="field-help">Fixing one changes the campaign: save it again and approve the new version.</p>
                    <button class="button primary" data-testid="export-anyway" @onclick="ExportAnywayAsync">Export anyway</button>
                    <p class="field-help">You won't be asked again about these for this campaign, in this version or a later one, while they read the same; only something new would come up. The export notes that you saw them and went on.</p>
                </section>
            }
            else
            {
                <section class="card">
                    <h2>Export</h2>
                    @if (Site.IsDemo && proofreadFindings.Any(f => f.Severity == Severity.Blocker))
                    {
                        <p class="muted" data-testid="export-waits-for-proofread-fix">The LLM found something to fix in this version. Fix it, save, and approve the new version.</p>
                    }
                    else if (Site.IsDemo && ProofreadOffered)
                    {
                        <p class="muted" data-testid="export-waits">On this demo, export comes once the campaign is approved with nothing left to fix. Unless this version is proofread with the LLM first, its blocks will be marked as not checked by the LLM.</p>
                    }
                    else if (Site.IsDemo)
                    {
                        <p class="muted" data-testid="export-waits">On this demo, export comes once the campaign is approved with nothing left to fix. Proofreading with the LLM isn't switched on yet, so its blocks will be marked as not checked by the LLM.</p>
                    }
                    else
                    {
                        <p class="muted" data-testid="export-waits">Export comes once proofreading with the LLM is switched on. A campaign leaves only after both the rules and the LLM have passed it.</p>
                    }
                </section>
            }
        </aside>
    </div>
}
else
{
    @* Until the reads are done: first as the page streams in, then again as it turns interactive.
       Never blank, and never the list it was opened from. *@
    <h1>@(Id is null ? "Starting a campaign" : "Opening the campaign")</h1>
    <p class="muted" role="status">One moment.</p>
}

@code {
    /// <summary>The template a new campaign starts from, for /campaigns/new/{templateId}.</summary>
    [Parameter]
    public Guid? TemplateId { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    private string? _denied;
    private string? _missing;
    // The client's registration could not be read: said instead of an editor whose checks would be wrong.
    private string? _unreadable;
    private CampaignStore? _store;
    private DraftSession? _session;
    // A campaign whose every save is undone, while it can still be restored.
    private SaveRef? _undone;
    private CampaignPolicy _policy = CampaignPolicy.Default;
    // The client's registration, for the phone numbers the checks hold the campaign to, with her
    // known items, which the pickers offer and the checks compare treatment names and benefits with.
    private BusinessContext? _business;
    private ClientName? _client;

    private KnownItems Known => _business?.Known ?? KnownItems.None;

    // What the checks are given: the registration and known items, with the names in her image
    // library, so a photo the library does not hold keeps only the note its field gives it, and the
    // tier-name ladders in force for her. Named by the client's name when it has no registration, as
    // for known items (ClientWorkspace.BusinessAsync).
    private BusinessContext Business =>
        (_business ?? new BusinessContext(_client!.ToString())) with
        {
            LibraryPhotos = _photos.Select(p => p.Name).ToList(),
            Ladders = _ladders,
            // For the AI proofread alone: where Square holds her photos, and what it read in them before.
            PhotoAddresses = _photos.Where(p => p.SquareUrl is not null)
                .GroupBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First().SquareUrl!, StringComparer.OrdinalIgnoreCase),
            PhotoReadings = Stores.PhotoReadings(_client!),
            // Today in her own zone, so a promotion that has ended is a Must fix (P5).
            Today = Times.Today(Clock.GetUtcNow()),
        };

    // The AI proofread is offered on the demo, when it is switched on (owner, 2026-10-10). Enforced
    // keeps its gate as it was: export there waits for the full review.
    private bool ProofreadOffered => Site.IsDemo && Proofreading.IsOn;

    private bool _proofreading;
    private string? _proofreadMessage;
    private string? _fixMessage;

    // "Use this" beside a finding (owner, 2026-10-31, answer 3b): the suggestion goes into the form,
    // unsaved. An LLM finding then greys at once; a rule's goes as the checks run again on this render.
    private void UseFix(Finding finding)
    {
        _fixMessage = SuggestedFix.Apply(_session!.Editor, finding) switch
        {
            FixOutcome.Applied => "Changed in the form. Save the campaign to keep it.",
            FixOutcome.Fixed => SuggestedFix.FixedText,
            _ => "The words it quotes aren't in that part any more. " + SuggestedFix.ByHand,
        };
    }

    // Her click, and only that, runs the proofread, of the saved version as it stands. It never throws
    // here: an exception on this interactive page would end the connection and her unsaved work with it.
    private async Task ProofreadAsync()
    {
        if (!ProofreadOffered || _proofreading) return;
        _proofreading = true;
        _proofreadMessage = null;
        try
        {
            var attempt = await _session!.ProofreadAsync(Proofreader, Allowance, Clock, _policy, Business);
            // Done: the line above the button says what it found, with when, as it does on reopening.
            // Said here as well, it read twice. Only a refusal or a failure is said here.
            _proofreadMessage = attempt.Done ? null : attempt.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "The LLM proofread of a campaign of {Client} could not be kept.", _client!.Value);
            _proofreadMessage = "The LLM report could not be kept just now. The rules' checks above still stand.";
        }
        finally
        {
            _proofreading = false;
        }
    }
    private TierLadders _ladders = TierLadders.Standard;

    // "Save as a known item" next to a tier or a benefit: kept exactly as written, then the pickers
    // and the checks read the list again. Neither may throw: on this interactive page an exception
    // ends the connection, and her unsaved campaign with it. A store failure comes back as a message
    // (logged by the session); a failure to read the list again keeps the list she had, logged here.
    private async Task<string> SaveKnownAsync(KnownItem item)
    {
        var message = await KnownItemsSession.SaveFromCampaignAsync(
            Workspace.Known, Recorder.For(_client!, await Workspace.ActorAsync()), item, Log);
        try
        {
            _business = await Workspace.BusinessAsync(_client!);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Could not read the registration of {Client} again after saving a known item.", _client!.Value);
        }
        return message;
    }
    // Once the campaign is saved (owner, 2026-11-01, P6: "It should be saved automatically"): a treatment
    // a promotion line names that is new to her list goes into her known items with its regular price,
    // through the known items session and store, and the save line says so. Never throws: the save stands.
    private async Task AddPromotionTreatmentsAsync()
    {
        var treatments = _session!.Editor.TreatmentsToSave(Known);
        if (treatments.Count == 0) return;
        var said = await KnownItemsSession.AddFromPromotionAsync(
            Workspace.Known, Recorder.For(_client!, await Workspace.ActorAsync()), treatments, Log);
        if (said.Count > 0) _message = string.Join(" ", new[] { _message }.Concat(said).OfType<string>());
        try
        {
            _business = await Workspace.BusinessAsync(_client!);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Could not read the registration of {Client} again after adding treatments from a promotion.", _client!.Value);
        }
    }

    private IReadOnlyList<LibraryImage> _photos = [];
    private string? _message;
    private bool _confirmingUndo;
    private bool _confirmingDelete;

    // Asking before an undo closes the question before a delete; Keep it closes only its own.
    private void ConfirmUndo(bool asking)
    {
        _confirmingUndo = asking;
        if (asking) _confirmingDelete = false;
    }

    // Her templates, the newest version of each, for the Template picker: read as the page opens, and
    // again after each template action and Load the latest, so a version saved meanwhile is seen.
    private IReadOnlyList<SaveRef> _templates = [];
    // The template she picked, by id; null until she picks one, when the picker shows the one attached,
    // or with none attached the one of hers with the campaign's template name.
    private string? _pickedTemplate;
    // A template that would lose something she wrote, while she is asked.
    private TemplateChoice? _askTemplate;
    private string? _templateMessage;

    // With none attached (a campaign saved before campaigns recorded theirs, until the one-time update
    // links it), nothing is picked: no template is guessed from a name.
    private string PickedTemplate =>
        _pickedTemplate
        ?? (_session!.TemplateStatus(_templates) is TemplateStanding.Current or TemplateStanding.Changed
            ? _session.Editor.Draft.TemplateId!.Value.ToString()
            : null)
        ?? "";

    private void PickTemplate(string? value)
    {
        _pickedTemplate = value;
        _askTemplate = null;
        _templateMessage = null;
    }

    private async Task LoadTemplatesAsync() => _templates = _session is null ? [] : await _session.TemplatesAsync();

    // Back to what the campaign on the page has: after the form is replaced from storage.
    private void ForgetTemplateChoice()
    {
        _pickedTemplate = null;
        _askTemplate = null;
        _templateMessage = null;
    }

    // "Use this template" and "Update to template": the picked template's newest version, read now, into
    // the form at once when nothing she wrote would be lost, otherwise asked first. Nothing is saved.
    private Task UseTemplateAsync() => ActingAsync(async () =>
    {
        _askTemplate = null;
        _templateMessage = null;
        if (!Guid.TryParse(PickedTemplate, out var id)) return;
        try
        {
            if (await _session!.ChooseTemplateAsync(id) is { } choice)
                TemplateUsed(choice, _session.UseTemplate(choice));
            else
            {
                _pickedTemplate = null;
                _templateMessage = "That template no longer exists. Choose another.";
            }
        }
        catch (InvalidOperationException ex)
        {
            _templateMessage = ex.Message;
        }
        await RefreshTemplatesAsync();
    }, "Template not used", SayOfTemplate);

    // "Use the template", once asked: applied if what would be lost is still no more than she was shown.
    private Task ConfirmTemplateAsync() => ActingAsync(async () =>
    {
        if (_askTemplate is not { } asked) return;
        try
        {
            TemplateUsed(asked, _session!.UseTemplate(asked, confirmed: true));
        }
        catch (InvalidOperationException ex)
        {
            _templateMessage = ex.Message;
        }
        await RefreshTemplatesAsync();
    }, "Template not used", SayOfTemplate);

    // The picker's list read again once the form has the template: a courtesy, so storage failing here
    // keeps the list she had and is only logged, and never reads as the template not being used.
    private async Task RefreshTemplatesAsync()
    {
        try
        {
            await LoadTemplatesAsync();
        }
        catch (Exception ex) when (StorageFailed.Is(ex))
        {
            Log.LogWarning(ex, "Could not read the templates of {Client} again; the picker keeps the list it had.", _client!.Value);
        }
    }

    // Where the page says what came of an action: the Save card, and beside the Template picker.
    private void Say(string message) => _message = message;

    private void SayOfTemplate(string message) => _templateMessage = message;

    private void TemplateUsed(TemplateChoice choice, TemplateChoice? ask)
    {
        _askTemplate = ask;
        if (ask is not null) return;
        _pickedTemplate = null;
        _templateMessage = $"The template {choice.Template.Name} is in the form now. Save the campaign to keep it" +
                           (_session!.Latest is null ? "." : "; leave without saving and the campaign stays as it was.");
    }
    // In the client's own zone, once it is known.
    private LocalTime? _times;
    private LocalTime Times => _times ?? Workspace.DefaultTimes;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Approving and exporting are the Review feature, on top of the page's Campaigns.
    private bool _canReview;
    private string _approver = "";

    // An untitled campaign is named for its template as that is named now, looked up by id.
    private string Title =>
        _session is null ? "Campaign"
        : _session.Editor.Draft.Subject.HasValue ? _session.Editor.Title
        : _session.TemplateNameNow(_templates) is { } template ? $"Untitled campaign from {template}"
        : "Untitled campaign";

    protected override async Task OnInitializedAsync()
    {
        var (client, reason) = await Workspace.ClientDataAsync();
        if (client is null)
        {
            _denied = reason;
            return;
        }
        _client = client;
        // Before the campaign, which streams in showing its times.
        _times = await Workspace.TimesAsync(client);
        if (AuthenticationState is not null)
            _canReview = (await Authorization.AuthorizeAsync((await AuthenticationState).User, Features.Review)).Succeeded;

        var actor = _actor = await Workspace.ActorAsync();
        // How many people must approve a version, from her registration: refused, like the rest of the
        // registration, when its row cannot be read, rather than taken as one.
        int approvalsRequired;
        try
        {
            approvalsRequired = await Workspace.ApprovalsRequiredAsync(client);
        }
        catch (RegistrationUnreadableException ex)
        {
            _unreadable = ex.Message;
            return;
        }
        var store = _store = Stores.Campaigns(client, actor, approvalsRequired);
        if (Id is { } id)
        {
            _session = await DraftSession.OpenAsync(store, id);
            if (_session is null) _undone = await DraftSession.RestorableAsync(store, id);
            if (_session is null && _undone is null) _missing = "Campaign not found";
        }
        else if (TemplateId is { } templateId)
        {
            _session = await DraftSession.StartAsync(store, templateId);
            if (_session is null) _missing = "Template not found";
        }
        await LoadTemplatesAsync();
        // What the campaign was just opened with is storage's as of now; listening and the timer start
        // once the page is live (WatchedComponent), never while it is rendered ahead of time.
        Watch(_session);
        try
        {
            await LoadChecksAsync(client, actor);
        }
        catch (RegistrationUnreadableException ex)
        {
            // Logged by the workspace. Without the registration the checks would pass numbers they
            // should flag, so the campaign is not shown as checked.
            _unreadable = ex.Message;
        }
    }

    // What the checks run with: the client's policy, ladders, registration with her known items, and
    // the photos in her library. Read as the page opens, and again at Approve and at Load the latest,
    // since another tab or person may have changed them meanwhile.
    // Throws RegistrationUnreadableException when the registration cannot be read.
    private async Task LoadChecksAsync(ClientName client, Actor actor)
    {
        _policy = await Stores.PolicyInForceAsync(client);
        _ladders = (await Stores.LaddersInForceAsync(client)).Ladders;
        _business = await Workspace.BusinessAsync(client);
        _photos = await Stores.Images(client, actor).ListAsync();
    }

    private Actor? _actor;

    // The watch's read last seen when the export was not offered (no approval in force): it is offered
    // again only from a later read, so it never comes back from what the page alone holds. The watch
    // (WatchedComponent.Watcher) also reads before the export is offered again; null until the page has opened.
    private int _exportVoidAt;
    private int? _exportCheckAsked;

    private bool ExportConfirmed(CampaignChange change) =>
        change == CampaignChange.None && Watcher is not null && Watcher.Observations > _exportVoidAt;

    // Live on its circuit, the watch started (WatchedComponent.OnAfterRender, from the first render after
    // the campaign is open; the page renders "One moment" before): whether the export may be offered.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Watcher is not { } watch) return;
        if (_session?.CurrentApproval is null)
        {
            _exportVoidAt = watch.Observations;
            return;
        }
        // Offered again since the last read: read once more, and the export shows if storage agrees.
        if (watch.Observations <= _exportVoidAt && _exportCheckAsked != _exportVoidAt)
        {
            _exportCheckAsked = _exportVoidAt;
            await watch.CheckAsync();
            StateHasChanged();
        }
    }

    // "Load the latest": the campaign as storage has it now, and the checks' lists with it, replacing
    // what is on the page, unsaved edits included. Only ever on her click.
    private Task LoadLatestAsync() => ActingAsync(async () =>
    {
        _confirmingUndo = _confirmingDelete = false;
        var id = _session!.Id!.Value;
        // Everything read first: storage failing on any of it leaves what she typed on the page.
        var latest = await DraftSession.OpenAsync(_store!, id);
        var undone = latest is null ? await DraftSession.RestorableAsync(_store!, id) : null;
        var templates = await _session.TemplatesAsync();
        try
        {
            await LoadChecksAsync(_client!, _actor!);
        }
        catch (RegistrationUnreadableException ex)
        {
            _unreadable = ex.Message;
        }
        _proofreadMessage = _fixMessage = null;
        _approver = "";
        _session = latest;
        Watch(latest);
        ForgetTemplateChoice();
        _templates = templates;
        if (latest is not null)
        {
            _message = "The latest version is open.";
            await ShowTitleAsync(Title);
            return;
        }
        // Every save undone meanwhile: the page offers Restore, as on opening a deleted campaign.
        _message = null;
        _undone = undone;
        if (_undone is null) _missing = "Campaign not found";
    }, "Not loaded", Say);

    // "Keep mine" / "Use this version again": what the page holds, saved as the newest version over
    // someone else's change. The other version stays stored; no approval comes with hers.
    private Task KeepMineAsync() => ActingAsync(async () =>
    {
        try
        {
            var kept = await _session!.KeepMineAsync();
            _message = DraftSession.KeptMessage(kept, Times);
            _confirmingUndo = _confirmingDelete = false;
            _proofreadMessage = null;
            await ShowTitleAsync(Title);
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }, "Not saved", Say);

    private Task SaveAsync() => ActingAsync(async () =>
    {
        // New until a save has gone through: a first save that storage failed has given the campaign an id
        // already, and the next save is still its first.
        var isNew = _session!.Latest is null;
        var before = _session.Latest;
        var saved = await _session.SaveAsync();
        // A campaign saved for the first time is watched from now.
        if (isNew) Watch(_session);
        _message = DraftSession.SavedMessage(before, saved, Times);
        _confirmingUndo = _confirmingDelete = false;
        // A new version: what was said of the last one's proofread, or of a fix put in, no longer applies.
        _proofreadMessage = _fixMessage = null;
        await AddPromotionTreatmentsAsync();
        // The address now names the campaign, so a reload opens what was saved. Only the address
        // changes: navigating would load the page afresh, at the top and without the saved line.
        if (isNew) await ShowAddressAsync(Navigation.ToAbsoluteUri($"campaigns/{saved.Id}").AbsoluteUri);
        await ShowTitleAsync(Title);
    }, "Not saved", Say);

    // The browser's address, replaced in place. A failure is only logged: the save stands, and the
    // campaign is in her list whatever the address bar says.
    private async Task ShowAddressAsync(string address)
    {
        try
        {
            await JS.InvokeVoidAsync("history.replaceState", null, "", address);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Log.LogWarning(ex, "Could not show the saved campaign's address.");
        }
    }

    // The tab's title, as a reload would show it. PageTitle sets it only as the page is first sent
    // (the head is not interactive), so after a save it is set here: the first save's tab otherwise
    // says "Untitled campaign" until a reload. A failure is only logged, as for the address.
    private async Task ShowTitleAsync(string title)
    {
        try
        {
            await JS.SetValueAsync("document.title", title);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Log.LogWarning(ex, "Could not show the saved campaign's title.");
        }
    }

    // Undo marks the save for deletion; nothing is deleted here, or by leaving the page. Only the version
    // on the page, while storage still has it as the newest: otherwise nothing is undone, and the page
    // says why and, once the read after it is done, what changed.
    private Task UndoAsync() => ActingAsync(async () =>
    {
        _confirmingUndo = _confirmingDelete = false;
        bool left;
        try
        {
            left = await _session!.UndoLastSaveAsync();
        }
        catch (CampaignChangedException ex)
        {
            _message = ex.Message;
            return;
        }
        ForgetTemplateChoice();
        if (left)
        {
            _message = "The last save was undone; the version before it is open.";
            return;
        }
        // Nothing left in use: the campaign is gone from the list, and can still be restored.
        _undone = _session.Restorable;
        _session = null;
        Watch(null);
        _message = null;
        if (_undone is null) _missing = "Campaign not found";
    }, "Not undone", Say);

    // Delete, as undo, only marks: every version of the campaign, restorable for the grace period here
    // and under Recently deleted, then swept. The page shows what it shows on opening a deleted campaign.
    // Refused when a version is approved, read again at the click: the page says why.
    private Task DeleteAsync() => ActingAsync(async () =>
    {
        _confirmingDelete = _confirmingUndo = false;
        try
        {
            await _session!.DeleteAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
            return;
        }
        ForgetTemplateChoice();
        _undone = _session.Restorable;
        _session = null;
        Watch(null);
        _message = null;
        if (_undone is null) _missing = "Campaign not found";
    }, "Not deleted", Say);

    private Task RestoreAsync() => ActingAsync(async () =>
    {
        _confirmingUndo = _confirmingDelete = false;
        var restored = await _session!.RestoreAsync();
        ForgetTemplateChoice();
        _message = restored
            ? "The undone save is back and open."
            : "That save can no longer be restored.";
    }, "Not restored", Say);

    private Task RestoreUndoneAsync() => ActingAsync(async () =>
    {
        _session = await DraftSession.RestoreAsync(_store!, _undone!);
        Watch(_session);
        _undone = null;
        ForgetTemplateChoice();
        await RefreshTemplatesAsync();
        if (_session is null) _missing = "Campaign not found";
        else _message = "The campaign is back and open.";
    }, "Not restored", Say);

    // At the click, what the approval rests on is read again: the campaign's newest save and its
    // approval (in DraftSession.ApproveAsync), and the lists the checks run with, since another tab or
    // person may have changed either since the page opened. The checks then run on the fresh lists,
    // which the page shows from now on; only a Must fix they find stops the approval, as always.
    private Task ApproveAsync() => ActingAsync(async () =>
    {
        if (!_canReview) return;
        try
        {
            if (!await ChecksStillPassAsync()) return;
            var approval = await _session!.ApproveAsync(_approver, _policy, Business);
            _message = _session.CurrentPartApproval is { } soFar
                ? DraftSession.PartApprovalWords(soFar, _session.ApprovalsRequired)
                : $"Approved by {approval.Names}.";
            _approver = "";
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _message = ex.Message;
        }
    }, "Not approved", Say);

    // The checks' lists read again, and the campaign checked with them: false, with what to tell her,
    // when it can no longer be approved as it stands.
    private async Task<bool> ChecksStillPassAsync()
    {
        try
        {
            await LoadChecksAsync(_client!, _actor!);
        }
        catch (RegistrationUnreadableException)
        {
            _message = "Not approved: the lists the checks use could not be read again just now. Try again in a moment.";
            return false;
        }
        if (_session!.CannotApprove(_policy, Business) is null) return true;
        _message = "Not approved: your known items, photos or check settings changed since this page opened, " +
                   "and the checks now find something to fix. It is listed under What the checks say.";
        return false;
    }

    private Task WithdrawAsync() => ActingAsync(async () =>
    {
        if (!_canReview) return;
        try
        {
            await _session!.WithdrawApprovalAsync();
            _message = "The approval is withdrawn.";
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }, "Not withdrawn", Say);

    // The demo's export, and only the demo's: an approved campaign, unchanged since, that the rules
    // pass, reviewed without the proofread and marked so (DraftSession.DemoExportReport). Null
    // everywhere else, Enforced included, where export waits for the proofread.
    private ReviewReport? ExportReport() =>
        Site.IsDemo && _canReview ? _session!.DemoExportReport(_policy, Business) : null;

    // The same gate's findings to show before that export, on the demo only, as the export is: those
    // nobody has been shown for this campaign yet, on this version or an earlier one. Checked with
    // the same business as the export (Business, with her library and ladders), so the list is
    // exactly what the export waits for.
    private IReadOnlyList<Finding> WarningsBeforeExport() =>
        Site.IsDemo && _canReview ? _session!.WarningsBeforeExport(_policy, Business) : [];

    // Whether someone went on past this campaign's warnings before, on this version or an earlier
    // one, with their keys kept: then the list holds only what is new since.
    private bool ExportedBefore => _session?.CurrentApproval?.WarningsSeen?.Keys is not null;

    // "Export anyway": recorded with this version's approval, who and when and the warnings' keys
    // (hashes, never their text), and then the export is there. A failure says why; the campaign is
    // untouched either way.
    private Task ExportAnywayAsync() => ActingAsync(async () =>
    {
        if (!Site.IsDemo || !_canReview) return;
        try
        {
            await _session!.WarningsSeenAtExportAsync(_policy, Business);
            _message = null;
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }, "Not exported", Say);

    // Where a finding's field is on this page: the subject line, or the block it is in. The address
    // is this campaign's own, so the link only moves down the page. Null for the whole email.
    private string? JumpTo(Finding finding)
    {
        var editor = _session!.Editor;
        var anchor = finding.Location == FindingPlace.Subject
            ? "subject"
            : FindingPlace.BlockIndex(finding.Location, editor.Blocks.Select(b => b.Label).ToList()) is { } i
                ? $"block-{i}"
                : null;
        return anchor is null ? null : $"campaigns/{_session.Id}#{anchor}";
    }

    // Where in a list the first finding the LLM made is, or -1: its "LLM" tag alone opens what LLM
    // means, so a list of LLM findings is not a row of buttons.
    private static int FirstLlm(IReadOnlyList<Finding> findings)
    {
        for (var i = 0; i < findings.Count; i++)
            if (findings[i].IsAi) return i;
        return -1;
    }

    // The JSON as a link to download, with no endpoint: an endpoint would be a second way out.
    private static string DataUrl(string json) =>
        "data:application/json;charset=utf-8;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));

    // Square's name for each kind, from the same table the assistant export writes its types from.
    private static string KindName(BlockKind kind) =>
        SquareWidgets.ByKind.TryGetValue(kind, out var widget) ? widget.DisplayName : kind.ToString();
}
