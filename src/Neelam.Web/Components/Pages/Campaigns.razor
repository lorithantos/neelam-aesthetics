@page "/campaigns"
@* A client's campaigns are its own data: the access check decides whose, on top of the policy.
   A campaign whose every save was undone is listed under Recently deleted while it can still be
   restored, with Restore: a plain form post, so it works on this page as it is served, with no
   connection held open. *@
@attribute [Authorize(Policy = Features.Campaigns)]
@inject ClientWorkspace Workspace
@inject ClientStores Stores
@inject NavigationManager Navigation
@inject IWorkingCopyDisk WorkingCopyDisk
@inject ILogger<Campaigns> Log

<PageTitle>Campaigns</PageTitle>

<h1>Campaigns</h1>

@if (_denied is not null)
{
    <p>You cannot see campaigns here: @_denied.</p>
}
else if (_campaigns is not null && _templates is not null)
{
    <p class="muted">Campaigns for @_displayName. Each save is kept as its own version until it is undone.</p>

    <section class="card" aria-labelledby="new-campaign">
        <h2 id="new-campaign">New campaign</h2>
        @if (_templates.Count == 0)
        {
            <p>There are no templates to start a campaign from yet. <a href="templates/new">Make a template first</a>.</p>
        }
        else
        {
            <p>Start from one of your templates. Its fixed parts come filled in; everything else starts empty.</p>
            <div class="block-actions">
                @foreach (var template in _templates)
                {
                    <a class="button" href="campaigns/new/@template.Id">@template.Title</a>
                }
            </div>
        }
    </section>

    <h2>Your campaigns</h2>
    @if (_campaigns.Count == 0)
    {
        <p>No campaigns yet.</p>
    }
    @* The campaign's name is its link, as well as Open: clicking the campaign opens it. *@
    @foreach (var (campaign, label) in _campaigns)
    {
        var href = $"campaigns/{campaign.Id}";
        <section class="card">
            @if (!string.IsNullOrWhiteSpace(label))
            {
                <h3><a href="@href">@label</a></h3>
                <p class="campaign-subject">@campaign.Title</p>
            }
            else
            {
                <h3><a href="@href">@campaign.Title</a></h3>
            }
            <p class="muted" data-testid="last-saved-@campaign.Id">Last saved @Times.DateAndTime(campaign.SavedAt)</p>
            <a class="button" href="@href">Open</a>
        </section>
    }

    @* Campaigns she typed into and never saved (owner, 2026-11-03): each from its working copy's name and
       metadata alone, as Recently deleted reads only names and marks. Open brings back what she typed; Discard
       removes it. Placeholder wording (WorkingCopyWords). *@
    @if (_notSaved is { Count: > 0 })
    {
        <h2 id="not-saved-yet">@WorkingCopyWords.NotSavedYetHeading</h2>
        @foreach (var unsaved in _notSaved)
        {
            var title = string.IsNullOrWhiteSpace(unsaved.Title) ? "Untitled campaign" : unsaved.Title;
            <section class="card" aria-label="Not saved yet: @title">
                <p data-testid="not-saved-@unsaved.CampaignId">@WorkingCopyWords.NotSavedYet(title, Times.DateAndTime(unsaved.WrittenAt))</p>
                <div class="block-actions">
                    <a class="button" href="campaigns/@unsaved.CampaignId">Open</a>
                    <form method="post" @formname="@($"discard-{unsaved.CampaignId:N}")" @onsubmit="() => DiscardAsync(unsaved)">
                        <AntiforgeryToken />
                        <button type="submit" class="button">@WorkingCopyWords.Discard</button>
                    </form>
                </div>
            </section>
        }
    }

    @if (_restoreMessage is not null)
    {
        <p role="alert">@_restoreMessage</p>
    }
    @if (_deleted is { Count: > 0 })
    {
        <h2 id="recently-deleted">Recently deleted</h2>
        <p class="muted">Deleted campaigns can be restored for @TimeWords.Period(_store!.UndoGracePeriod). After that they are removed for good.</p>
        @foreach (var deleted in _deleted)
        {
            <section class="card" aria-label="Deleted: @deleted.Title">
                <h3>@deleted.Title</h3>
                <p class="muted">Deleted @Times.DateAndTime(deleted.UndoneAt!.Value). It will be removed for good @Times.DateAndTime(_store.RestorableUntil(deleted)!.Value).</p>
                <form method="post" @formname="@($"restore-{deleted.Id:N}")" @onsubmit="() => RestoreAsync(deleted)">
                    <AntiforgeryToken />
                    <button type="submit" class="button">Restore</button>
                </form>
            </section>
        }
    }
}

@code {
    private string? _denied;
    private ClientName? _client;
    private string? _displayName;
    private CampaignStore? _store;
    // Each with her label, read from its newest save's JSON: one read per campaign.
    private IReadOnlyList<CampaignListing>? _campaigns;
    private IReadOnlyList<SaveRef>? _templates;
    // Campaigns whose every save is undone, still restorable; read from names and marks only.
    private IReadOnlyList<SaveRef>? _deleted;
    private string? _restoreMessage;
    // In the client's own zone, once it is known.
    private LocalTime? _times;
    private LocalTime Times => _times ?? Workspace.DefaultTimes;

    protected override async Task OnInitializedAsync()
    {
        (_client, var reason) = await Workspace.ClientDataAsync();
        if (_client is null)
        {
            _denied = reason;
            return;
        }
        _displayName = await Workspace.DisplayNameAsync(_client);
        _times = await Workspace.TimesAsync(_client);
        var store = _store = Stores.Campaigns(_client, await Workspace.ActorAsync());
        _campaigns = await DraftSession.ListLabelledAsync(store);
        _templates = (await store.LatestAsync(DocumentKind.Template))
            .OrderBy(t => t.Title, StringComparer.CurrentCultureIgnoreCase).ToList();
        _deleted = await DraftSession.RecentlyDeletedAsync(store);
        await ListNotSavedAsync();
    }

    // Campaigns typed into and never saved; one listed above, or under Recently deleted, is not this.
    private IReadOnlyList<NotSavedYet>? _notSaved;

    private async Task ListNotSavedAsync()
    {
        var listed = _campaigns!.Select(c => c.Save.Id).Concat(_deleted!.Select(d => d.Id)).ToHashSet();
        // And those that reached only the server's disk, storage being down for all of her first session on
        // them: from each one's sidecar alone. The disk failing is logged; the list goes on without them.
        IReadOnlyList<NotSavedYet> onDisk = [];
        try
        {
            onDisk = await WorkingCopyDisk.ListNotSavedYetAsync(_client!);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogError(ex, "Could not list the disk copies of {Client}; the list shows those in storage.", _client!.Value);
        }
        _notSaved = NotSavedYet.Merge(await _store!.WorkingCopies.NotSavedYetAsync(), onDisk)
            .Where(c => !listed.Contains(c.CampaignId)).ToList();
    }

    // "Discard" on a campaign never saved: its working copy goes, from storage and the server's disk.
    private async Task DiscardAsync(NotSavedYet unsaved)
    {
        await _store!.WorkingCopies.RemoveAsync(unsaved.CampaignId);
        try
        {
            await WorkingCopyDisk.RemoveAsync(_client!, unsaved.CampaignId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogError(ex, "Could not remove the disk copy of campaign {Campaign}; the sweep will.", unsaved.CampaignId);
        }
        await ListNotSavedAsync();
    }

    // Restored, the campaign opens; past its grace period meanwhile, the list says so.
    private async Task RestoreAsync(SaveRef deleted)
    {
        if (await DraftSession.RestoreAsync(_store!, deleted) is not null)
        {
            Navigation.NavigateTo($"campaigns/{deleted.Id}");
            return;
        }
        _restoreMessage = $"\"{deleted.Title}\" can no longer be restored.";
        _deleted = await DraftSession.RecentlyDeletedAsync(_store!);
    }
}
