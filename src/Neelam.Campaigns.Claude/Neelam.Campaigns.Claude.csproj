<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.53.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the proofread is told is data the app reads at startup (ProofreadInstructions.Shipped),
         copied into the output of every project that references this one, under Proofread/. -->
    <Content Include="Proofread\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neelam.Campaigns\Neelam.Campaigns.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The request is built by an internal method, so the tests can pin what Claude is told. -->
    <InternalsVisibleTo Include="Neelam.Campaigns.Tests" />
  </ItemGroup>

</Project>
